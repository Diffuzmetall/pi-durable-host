# secrets and this machine's device list (template: dpi-network.example.yaml)
dpi-network.yaml
.env
.env.*
!.env.example
**/backend.env

# dependencies and builds
node_modules/
**/node_modules
**/dist/
.venv/
__pycache__/

# runtime data (agent databases never belong in git)
**/.durable-pi/
**/.data/
**/workspace/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.lock
!package-lock.json
!uv.lock

# agent scratch space for the e2e scenario (tests/e2e-network.mjs)
/e2e/

# local artifacts
test-results/
tmp/
*.log
.DS_Store

# private machine state and derived inspection indexes
/data/
/.audit/
/.codegraph/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm

# reproducible experiment outputs, not sources or live-state publication
/experiments/**/compiled/
/experiments/**/artifacts/
/experiments/**/evidence/
/experiments/sdk-host-cutover/nico-build-*/
/experiments/host-sse-mcp140-20261031/candidate/
/docs/host-design/verification/**/evidence/
