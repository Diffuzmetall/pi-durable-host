index 0000000..4a78f08
--- /dev/null
+++ b/apps/server/test/threads/native-existing-handler.test.ts
@@ -0,0 +1,74 @@
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Hono } from "hono";
+import { createConnection, migrate, createThread, createProject, createEnvironment, upsertHost, getThread, getThreadPluginMetadata, listEvents, findForeignNativeThreadRegistration } from "@bb/db";
+import { expect, it } from "vitest";
+import { NotificationHub } from "../../src/ws/hub.js";
+import { createMachineAuthService } from "../../src/services/machine-auth.js";
+import { registerInternalHostRoutes } from "../../src/internal/hosts.js";
+import { verifyAuthenticatedDaemon, setAuthenticatedDaemon } from "../../src/internal/auth.js";
+import { ApiError } from "../../src/errors.js";
+import type { AppDeps } from "../../src/types.js";
+
+it("registers durably through real daemon authentication without submitting a turn", async () => {
+  const dataDir = mkdtempSync(join(tmpdir(), "bb-core-sol-fixture-"));
+  const db = createConnection(join(dataDir, "private.sqlite"));
+  migrate(db);
+  const hub = new NotificationHub();
+  const logger = { info() {}, warn() {}, error() {}, debug() {} };
+  const machineAuth = await createMachineAuthService({ db, dataDir, logger });
+  await machineAuth.ensureReady();
+  const deps = { db, hub, machineAuth } as AppDeps;
+  const app = new Hono();
+  app.onError((error, context) => context.json({ error: error.message }, error instanceof ApiError ? error.status : 500));
+  app.use("/internal/*", async (context, next) => {
+    try {
+      const daemon = await verifyAuthenticatedDaemon(deps, context.req.header("authorization"));
+      setAuthenticatedDaemon(context, daemon);
+    } catch {
+      return context.json({ error: "Unauthorized" }, 401);
+    }
+    return next();
+  });
+  const internal = new Hono();
+  registerInternalHostRoutes(internal, deps);
+  app.route("/internal", internal);
+  function parent(hostId: string) {
+    upsertHost(db, hub, { id: hostId, name: hostId });
+    const { project } = createProject(db, hub, { name: hostId, source: { type: "local_path", hostId, path: dataDir } });
+    const environment = createEnvironment(db, hub, { hostId, projectId: project.id, path: dataDir, providerOwnsPath: false, status: "ready" });
+    return createThread(db, hub, { projectId: project.id, environmentId: environment.id, providerId: "pi-durable", title: hostId, status: "pending" });
+  }
+  const ownerParent = parent("synthetic-owner");
+  const foreignParent = parent("synthetic-foreign");
+  const ownerKey = await machineAuth.issueDaemonHostKey({ hostId: "synthetic-owner" });
+  const foreignKey = await machineAuth.issueDaemonHostKey({ hostId: "synthetic-foreign" });
+  const body = { requestId: "registration-1", providerId: "pi-durable", sessionId: "session-1", conversationId: "conversation-1", parentThreadId: ownerParent.id, title: "Existing child" };
+  const register = (key: string, input = body) => app.request("/internal/hosts/threads/register-existing", { method: "POST", headers: { authorization: `Bearer ${key}`, "content-type": "application/json" }, body: JSON.stringify(input) });
+  try {
+    expect((await register("invalid")).status).toBe(401);
+    const created = await register(ownerKey);
+    expect(created.status).toBe(201);
+    const result = await created.json() as { threadId: string };
+    expect(getThread(db, result.threadId)).toMatchObject({ parentThreadId: ownerParent.id, providerId: "pi-durable", status: "pending" });
+    expect(listEvents(db, { threadId: result.threadId })).toEqual([]);
+    expect(getThreadPluginMetadata(db, result.threadId, "bb.core.native-registration").metadata).toMatchObject({ hostId: "synthetic-owner", sessionId: "session-1", conversationId: "conversation-1" });
+    expect(findForeignNativeThreadRegistration(db, { hostId: "synthetic-owner", providerId: body.providerId, sessionId: body.sessionId, conversationId: body.conversationId })).toBeUndefined();
+    expect(findForeignNativeThreadRegistration(db, { hostId: "synthetic-foreign", providerId: body.providerId, sessionId: body.sessionId, conversationId: body.conversationId })).toEqual({ threadId: result.threadId });
+    expect(findForeignNativeThreadRegistration(db, { hostId: "synthetic-foreign", providerId: "another-provider", sessionId: body.sessionId, conversationId: body.conversationId })).toBeUndefined();
+    expect(findForeignNativeThreadRegistration(db, { hostId: "synthetic-foreign", providerId: body.providerId, sessionId: "another-session", conversationId: body.conversationId })).toBeUndefined();
+    const retry = await register(ownerKey);
+    expect(retry.status).toBe(200);
+    expect(await retry.json()).toEqual(result);
+    expect((await register(ownerKey, { ...body, conversationId: "mismatch" })).status).toBe(409);
+    expect((await register(foreignKey)).status).toBe(404);
+    expect((await register(foreignKey, { ...body, parentThreadId: foreignParent.id })).status).toBe(409);
+    expect((await register(ownerKey, { ...body, initialPrompt: "forbidden" } as typeof body)).status).toBe(400);
+    const reopened = createConnection(join(dataDir, "private.sqlite"));
+    try {
+      expect(getThread(reopened, result.threadId)?.parentThreadId).toBe(ownerParent.id);
+      expect(listEvents(reopened, { threadId: result.threadId })).toEqual([]);
+    } finally { reopened.$client.close(); }
+  } finally { db.$client.close(); }
+});
diff --git a/apps/server/test/threads/native-existing-registration.test.ts b/apps/server/test/threads/native-existing-registration.test.ts
new file mode 100644
index 0000000..79f24b7
--- /dev/null
+++ b/apps/server/test/threads/native-existing-registration.test.ts
@@ -0,0 +1,149 @@
+import {
+  createThread,
+  getThread,
+  getThreadPluginMetadata,
+  listEvents,
+} from "@bb/db";
+import { describe, expect, it } from "vitest";
+import { withTestHarness } from "../helpers/test-app.js";
+import {
+  seedEnvironment,
+  seedHostSession,
+  seedProjectWithSource,
+} from "../helpers/seed.js";
+
+const endpoint = "/internal/hosts/threads/register-existing";
+const bindingPluginId = "bb.core.native-registration";
+
+async function register(
+  app: { request: (input: RequestInfo | URL, init?: RequestInit) => Promise<Response> | Response },
+  hostKey: string,
+  body: Record<string, unknown>,
+) {
+  return app.request(endpoint, {
+    method: "POST",
+    headers: {
+      authorization: `Bearer ${hostKey}`,
+      "content-type": "application/json",
+    },
+    body: JSON.stringify(body),
+  });
+}
+
+describe("authenticated native existing-thread registration", () => {
+  it("persists one pending BB child, returns it on retry, rejects conflicts and foreign parents without execution", async () => {
+    await withTestHarness(async (harness) => {
+      const { host: owner } = seedHostSession(harness.deps, { id: "host-owner" });
+      const { project: ownerProject } = seedProjectWithSource(harness.deps, {
+        hostId: owner.id,
+        path: "/tmp/native-registration-owner",
+      });
+      const ownerEnvironment = seedEnvironment(harness.deps, {
+        hostId: owner.id,
+        projectId: ownerProject.id,
+        path: "/tmp/native-registration-owner",
+      });
+      const parent = createThread(harness.db, harness.hub, {
+        projectId: ownerProject.id,
+        environmentId: ownerEnvironment.id,
+        providerId: "codex",
+        title: "Durable parent",
+        status: "pending",
+      });
+      const request = {
+        requestId: "durable-session-7/conversation-42",
+        providerId: "codex",
+        sessionId: "durable-session-7",
+        conversationId: "conversation-42",
+        parentThreadId: parent.id,
+        title: "Existing Durable conversation",
+      };
+      const hostKey = await harness.deps.machineAuth.issueDaemonHostKey({
+        hostId: owner.id,
+      });
+
+      const createdResponse = await register(harness.app, hostKey, request);
+      expect(createdResponse.status).toBe(201);
+      const created = (await createdResponse.json()) as { threadId: string };
+      const registered = getThread(harness.db, created.threadId);
+      expect(registered).toMatchObject({
+        id: created.threadId,
+        projectId: ownerProject.id,
+        environmentId: ownerEnvironment.id,
+        parentThreadId: parent.id,
+        providerId: "codex",
+        status: "pending",
+      });
+      expect(listEvents(harness.db, { threadId: created.threadId })).toEqual([]);
+      expect(
+        getThreadPluginMetadata(
+          harness.db,
+          created.threadId,
+          bindingPluginId,
+        ).metadata,
+      ).toMatchObject({
+        kind: "native-existing",
+        hostId: owner.id,
+        requestId: request.requestId,
+        sessionId: request.sessionId,
+        conversationId: request.conversationId,
+        parentThreadId: parent.id,
+      });
+
+      const retryResponse = await register(harness.app, hostKey, request);
+      expect(retryResponse.status).toBe(200);
+      expect(await retryResponse.json()).toEqual(created);
+
+      const conflictResponse = await register(harness.app, hostKey, {
+        ...request,
+        conversationId: "different-conversation",
+      });
+      expect(conflictResponse.status).toBe(409);
+
+      const { host: foreign } = seedHostSession(harness.deps, {
+        id: "host-foreign",
+      });
+      const { project: foreignProject } = seedProjectWithSource(harness.deps, {
+        hostId: foreign.id,
+        path: "/tmp/native-registration-foreign",
+      });
+      const foreignEnvironment = seedEnvironment(harness.deps, {
+        hostId: foreign.id,
+        projectId: foreignProject.id,
+        path: "/tmp/native-registration-foreign",
+      });
+      const foreignParent = createThread(harness.db, harness.hub, {
+        projectId: foreignProject.id,
+        environmentId: foreignEnvironment.id,
+        providerId: "codex",
+        title: "Foreign parent",
+        status: "pending",
+      });
+      const foreignParentResponse = await register(harness.app, hostKey, {
+        ...request,
+        requestId: "forged-parent-attempt",
+        parentThreadId: foreignParent.id,
+      });
+      expect(foreignParentResponse.status).toBe(404);
+
+      const foreignHostKey = await harness.deps.machineAuth.issueDaemonHostKey({
+        hostId: foreign.id,
+      });
+      const foreignSessionResponse = await register(
+        harness.app,
+        foreignHostKey,
+        {
+          ...request,
+          requestId: "foreign-session-attempt",
+          parentThreadId: foreignParent.id,
+        },
+      );
+      expect(foreignSessionResponse.status).toBe(409);
+
+      expect(
+        getThread(harness.db, created.threadId)?.status,
+      ).toBe("pending");
+      expect(listEvents(harness.db, { threadId: created.threadId })).toEqual([]);
+    });
+  });
+});
diff --git a/apps/server/test/threads/native-history-timeline.test.ts b/apps/server/test/threads/native-history-timeline.test.ts
new file mode 100644
index 0000000..1cc7148
--- /dev/null
+++ b/apps/server/test/threads/native-history-timeline.test.ts
@@ -0,0 +1,261 @@
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { listStoredEventRows } from "@bb/db";
+import {
+  threadScope,
+  turnScope,
+  type HistoricalSnapshot,
+} from "@bb/domain";
+import {
+  threadTimelineResponseSchema,
+  type TimelineRow,
+} from "@bb/server-contract";
+import { readJson } from "../helpers/json.js";
+import { seedStoredEvent, seedThreadFixture } from "../helpers/seed.js";
+import { withTestHarness } from "../helpers/test-app.js";
+import type { TestAppHarness } from "../helpers/test-app.js";
+
+type LegacyFixtureItem =
+  | {
+      type: "userMessage";
+      id: string;
+      content: { type: "text"; text: string }[];
+      origin: "historical";
+    }
+  | { type: "agentMessage"; id: string; text: string };
+
+type LegacyFixtureEvent =
+  | { type: "thread/identity"; data: { providerThreadId: string } }
+  | { type: "turn/started"; data: { providerThreadId: string } }
+  | {
+      type: "item/completed";
+      data: { providerThreadId: string; item: LegacyFixtureItem };
+    }
+  | {
+      type: "turn/completed";
+      data: { providerThreadId: string; status: "completed" };
+    };
+
+const legacyFixtureUrl = new URL(
+  "../fixtures/native-child-timeline-sanitized.json",
+  import.meta.url,
+);
+const legacyFixture = JSON.parse(
+  readFileSync(legacyFixtureUrl, "utf8"),
+) as LegacyFixtureEvent[];
+const probeText = "SYNTHETIC_NATIVE_CHILD_PROBE";
+
+function collectConversationRows(
+  rows: readonly TimelineRow[],
+): Extract<TimelineRow, { kind: "conversation" }>[] {
+  return rows.flatMap((row) => {
+    if (row.kind === "conversation") return [row];
+    const nested =
+      ("childRows" in row ? row.childRows : undefined) ??
+      ("children" in row ? row.children : undefined) ??
+      [];
+    return collectConversationRows(nested);
+  });
+}
+
+async function createRegisteredChild(harness: TestAppHarness) {
+  const { host, environment, thread: parent } = seedThreadFixture(harness, {
+    session: { id: "native-history-fixture-host" },
+    thread: { providerId: "pi-durable", status: "pending" },
+  });
+  const providerThreadId = legacyFixture[0]!.data.providerThreadId;
+  const separator = providerThreadId.lastIndexOf(":");
+  if (separator < 1 || separator === providerThreadId.length - 1) {
+    throw new Error(
+      "Sanitized native-child fixture has an invalid providerThreadId",
+    );
+  }
+  const sessionId = providerThreadId.slice(0, separator);
+  const conversationId = providerThreadId.slice(separator + 1);
+  const request = {
+    requestId: `${sessionId}/${conversationId}`,
+    providerId: "pi-durable",
+    sessionId,
+    conversationId,
+    parentThreadId: parent.id,
+    title: "Synthetic native child history",
+  };
+  const hostKey = await harness.deps.machineAuth.issueDaemonHostKey({
+    hostId: host.id,
+  });
+  const response = await harness.app.request(
+    "/internal/hosts/threads/register-existing",
+    {
+      method: "POST",
+      headers: {
+        authorization: `Bearer ${hostKey}`,
+        "content-type": "application/json",
+      },
+      body: JSON.stringify(request),
+    },
+  );
+  expect(response.status).toBe(201);
+  const registered = (await readJson(response)) as { threadId: string };
+  return {
+    environment,
+    providerThreadId,
+    threadId: registered.threadId,
+    hostKey,
+  };
+}
+
+function seedLegacyHistory(
+  harness: TestAppHarness,
+  args: { environmentId: string; providerThreadId: string; threadId: string },
+): void {
+  const turnId = "synthetic-legacy-turn";
+  legacyFixture.forEach((event, index) => {
+    const scope =
+      event.type === "thread/identity" ? threadScope() : turnScope(turnId);
+    const item = event.type === "item/completed" ? event.data.item : undefined;
+    seedStoredEvent(harness.deps, {
+      threadId: args.threadId,
+      environmentId: args.environmentId,
+      providerThreadId: args.providerThreadId,
+      sequence: index + 1,
+      createdAt: 1_700_000_000_000 + index,
+      type: event.type,
+      scope,
+      data: { ...event.data },
+      ...(item
+        ? { itemId: item.id, itemKind: item.type }
+        : {}),
+    });
+  });
+}
+
+function canonicalSnapshotFromFixture(): HistoricalSnapshot {
+  const items: HistoricalSnapshot["items"] = [];
+  legacyFixture.forEach((event, index) => {
+    if (event.type !== "item/completed") return;
+    const source = {
+      entryId: `synthetic-entry-${index}`,
+      messageIndex: index,
+      blockIndex: 0,
+    };
+    if (event.data.item.type === "userMessage") {
+      items.push({
+        source,
+        item: {
+          type: "userMessage",
+          content: event.data.item.content,
+        },
+      });
+      return;
+    }
+    items.push({
+      source,
+      item: {
+        type: "agentMessage",
+        text: event.data.item.text,
+      },
+    });
+  });
+  return { status: "completed", items };
+}
+
+async function getTimeline(harness: TestAppHarness, threadId: string) {
+  const response = await harness.app.request(
+    `/api/v1/threads/${threadId}/timeline?includeNestedRows=true`,
+  );
+  expect(response.status).toBe(200);
+  return threadTimelineResponseSchema.parse(await readJson(response));
+}
+
+describe("native child history timeline compatibility", () => {
+  it("renders imported 0.46 history without rewriting its stored legacy item", async () => {
+    await withTestHarness(async (harness) => {
+      const child = await createRegisteredChild(harness);
+      seedLegacyHistory(harness, {
+        environmentId: child.environment.id,
+        providerThreadId: child.providerThreadId,
+        threadId: child.threadId,
+      });
+
+      const timeline = await getTimeline(harness, child.threadId);
+      expect(
+        collectConversationRows(timeline.rows).map(({ role, text }) => ({
+          role,
+          text,
+        })),
+      ).toEqual([
+        { role: "user", text: probeText },
+        { role: "assistant", text: probeText },
+      ]);
+
+      const userRow = listStoredEventRows(harness.db, {
+        threadId: child.threadId,
+      }).find((row) => row.itemKind === "userMessage");
+      if (!userRow) throw new Error("Legacy user item was not stored");
+      expect(JSON.parse(userRow.data).item).toMatchObject({
+        origin: "historical",
+      });
+    });
+  });
+
+  it("writes canonical history that renders through the API and remains idempotent", async () => {
+    await withTestHarness(async (harness) => {
+      const child = await createRegisteredChild(harness);
+      const snapshot = canonicalSnapshotFromFixture();
+      const request = {
+        threadId: child.threadId,
+        providerId: "pi-durable",
+        providerThreadId: child.providerThreadId,
+        expectedDigest: null as string | null,
+        snapshot,
+      };
+      const reconcile = (input: typeof request) =>
+        harness.app.request("/internal/hosts/threads/reconcile-existing", {
+          method: "POST",
+          headers: {
+            authorization: `Bearer ${child.hostKey}`,
+            "content-type": "application/json",
+          },
+          body: JSON.stringify(input),
+        });
+
+      const firstResponse = await reconcile(request);
+      expect(firstResponse.status).toBe(200);
+      const first = (await readJson(firstResponse)) as {
+        changed: boolean;
+        digest: string | null;
+      };
+      expect(first.changed).toBe(true);
+      if (first.digest === null) {
+        throw new Error("New native history did not return its digest");
+      }
+      const digest = first.digest;
+      const timeline = await getTimeline(harness, child.threadId);
+      expect(
+        collectConversationRows(timeline.rows).map(({ role, text }) => ({
+          role,
+          text,
+        })),
+      ).toEqual([
+        { role: "user", text: probeText },
+        { role: "assistant", text: probeText },
+      ]);
+
+      const storedUserRow = listStoredEventRows(harness.db, {
+        threadId: child.threadId,
+      }).find((row) => row.itemKind === "userMessage");
+      if (!storedUserRow) throw new Error("Canonical user item was not stored");
+      expect(JSON.parse(storedUserRow.data).item).not.toHaveProperty("origin");
+
+      const retryResponse = await reconcile({
+        ...request,
+        expectedDigest: digest,
+      });
+      expect(retryResponse.status).toBe(200);
+      expect(await readJson(retryResponse)).toMatchObject({
+        changed: false,
+        digest,
+      });
+    });
+  });
+});
diff --git a/apps/server/test/threads/native-root-recovery.test.ts b/apps/server/test/threads/native-root-recovery.test.ts
new file mode 100644
index 0000000..8606b44
--- /dev/null
+++ b/apps/server/test/threads/native-root-recovery.test.ts
@@ -0,0 +1,79 @@
+import {
+  appendStoredThreadEvent,
+  createThread,
+  getThread,
+  listEvents,
+  noopNotifier,
+} from "@bb/db";
+import { formatClientTurnRequestIdSuffix, threadScope, turnScope } from "@bb/domain";
+import { describe, expect, it } from "vitest";
+import { withTestHarness } from "../helpers/test-app.js";
+import { seedEnvironment, seedHostSession, seedProjectWithSource } from "../helpers/seed.js";
+import { stableRootProviderId } from "@bb/host-daemon-contract";
+
+const endpoint = "/internal/hosts/threads/recover-native-root";
+const snapshot = {
+  sessionId: "native-session",
+  conversationId: 1 as const,
+  userEntryId: 10,
+  answerEntryId: 11,
+  inputs: [{ entryId: 10, text: "one input" }],
+  answerText: "saved answer",
+  status: "completed" as const,
+};
+
+async function recover(app: { request: (input: URL | RequestInfo, init?: RequestInit) => Response | Promise<Response> }, hostKey: string, body: unknown) {
+  return app.request(endpoint, { method: "POST", headers: { authorization: `Bearer ${hostKey}`, "content-type": "application/json" }, body: JSON.stringify(body) });
+}
+
+describe("authenticated existing-root recovery", () => {
+  it("prepares and applies a backup-first same-turn repair, retries idempotently, and refuses a foreign host", async () => {
+    await withTestHarness(async (harness) => {
+      const { host: owner } = seedHostSession(harness.deps, { id: "native-root-owner" });
+      const { project } = seedProjectWithSource(harness.deps, { hostId: owner.id, path: "/tmp/native-root-owner" });
+      const environment = seedEnvironment(harness.deps, { hostId: owner.id, projectId: project.id, path: "/tmp/native-root-owner" });
+      const thread = createThread(harness.db, harness.hub, { projectId: project.id, environmentId: environment.id,
+        providerId: "pi-durable", title: "Existing native root", status: "error" });
+      const providerThreadId = stableRootProviderId(thread.id);
+      const requestId = formatClientTurnRequestIdSuffix({ suffix: "23456789ab" });
+      appendStoredThreadEvent(harness.db, noopNotifier, { threadId: thread.id, scope: threadScope(), providerThreadId,
+        type: "thread/identity", data: { providerThreadId } });
+      appendStoredThreadEvent(harness.db, noopNotifier, { threadId: thread.id, scope: threadScope(),
+        type: "client/turn/requested", data: { direction: "outbound", source: "tell", initiator: "user", senderThreadId: null,
+          requestId, input: [{ type: "text", text: "one input", mentions: [] }], target: { kind: "new-turn" }, request: { method: "turn/start", params: {} },
+          execution: { model: "gpt-5", reasoningLevel: "medium", permissionMode: "workspace-write", source: "client/turn/requested", serviceTier: "default" } } });
+      appendStoredThreadEvent(harness.db, noopNotifier, { threadId: thread.id, scope: turnScope("existing-turn"), providerThreadId,
+        type: "turn/started", data: { providerThreadId } });
+      appendStoredThreadEvent(harness.db, noopNotifier, { threadId: thread.id, scope: turnScope("existing-turn"), providerThreadId,
+        type: "turn/input/accepted", data: { providerThreadId, clientRequestId: requestId } });
+      appendStoredThreadEvent(harness.db, noopNotifier, { threadId: thread.id, scope: turnScope("existing-turn"), providerThreadId,
+        type: "item/started", data: { providerThreadId, item: { type: "agentMessage", id: "partial-item", text: "" } } });
+      appendStoredThreadEvent(harness.db, noopNotifier, { threadId: thread.id, scope: turnScope("existing-turn"), providerThreadId,
+        type: "item/agentMessage/delta", data: { providerThreadId, itemId: "partial-item", delta: "saved " } });
+      const ownerKey = await harness.deps.machineAuth.issueDaemonHostKey({ hostId: owner.id });
+      const before = listEvents(harness.db, { threadId: thread.id });
+      const selector = { threadId: thread.id, providerThreadId };
+
+      const preparedResponse = await recover(harness.app, ownerKey, { operation: "prepare", ...selector });
+      expect(preparedResponse.status).toBe(200);
+      const prepared = await preparedResponse.json() as { status: string; backupDigest: string; backup: { events: unknown[] } };
+      expect(prepared.status).toBe("prepared");
+      expect(prepared.backup.events).toHaveLength(before.length);
+      expect(listEvents(harness.db, { threadId: thread.id })).toEqual(before);
+
+      const { host: foreign } = seedHostSession(harness.deps, { id: "native-root-foreign" });
+      const foreignKey = await harness.deps.machineAuth.issueDaemonHostKey({ hostId: foreign.id });
+      expect((await recover(harness.app, foreignKey, { operation: "prepare", ...selector })).status).toBe(404);
+
+      const applyBody = { operation: "apply", ...selector, backupDigest: prepared.backupDigest, snapshot };
+      const appliedResponse = await recover(harness.app, ownerKey, applyBody);
+      expect(appliedResponse.status).toBe(200);
+      expect(await appliedResponse.json()).toMatchObject({ status: "recovered", threadId: thread.id, changed: true, turnId: "existing-turn", itemId: "partial-item" });
+      expect(getThread(harness.db, thread.id)?.status).toBe("idle");
+      const retried = await recover(harness.app, ownerKey, applyBody);
+      expect(retried.status).toBe(200);
+      expect(await retried.json()).toMatchObject({ status: "recovered", changed: false });
+      expect(listEvents(harness.db, { threadId: thread.id }).filter(event => event.type === "item/completed")).toHaveLength(1);
+    });
+  });
+});
diff --git a/bb-extension/bootstrap/operator-profile-enrollment.ts b/bb-extension/bootstrap/operator-profile-enrollment.ts
new file mode 100644
index 0000000..9f4c379
--- /dev/null
+++ b/bb-extension/bootstrap/operator-profile-enrollment.ts
@@ -0,0 +1,65 @@
+import { createHash } from 'node:crypto';
+import { isDeepStrictEqual } from 'node:util';
+import { isAbsolute, relative, resolve, join } from 'node:path';
+import { assertPrivateOwnerParent, readPrivateOwnerJson } from './owner-grant.ts';
+import { readSelectedNativeSession, operatorGrantConfig, type OperatorGrantConfig, type SelectedNativeSession } from './provider-grant.ts';
+import { provisionPrivateOperatorFile } from './operator-profile.ts';
+export type OperatorAttachmentSelectors = Readonly<{ requestId: string; hostId: string; projectId: string; environmentId: string; providerId: 'pi-durable' }>;
+export type OperatorEnrollment = OperatorAttachmentSelectors & Readonly<OperatorGrantConfig> & Readonly<{ protocol: 'bb-durable-operator-enrollment/v1'; nativeContext: SelectedNativeSession }>;
+const sha = (value: unknown) => createHash('sha256').update(JSON.stringify(value), 'utf8').digest('hex');
+function selectors(value: OperatorAttachmentSelectors): void {
+  if (Object.keys(value).length !== 5 || !['requestId','hostId','projectId','environmentId','providerId'].every(k => Object.hasOwn(value,k))
+    || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(value.requestId)
+    || value.providerId !== 'pi-durable' || [value.hostId, value.projectId, value.environmentId].some(v => typeof v !== 'string' || !v.trim() || v !== v.trim() || v.length > 256))
+    throw Error('BB_OPERATOR_ENROLLMENT_SELECTORS_INVALID');
+}
+export function operatorEnrollmentPath(sdkDataDir: string, requestId: string): string {
+  if (!isAbsolute(sdkDataDir) || resolve(sdkDataDir) !== sdkDataDir || sdkDataDir.includes('\0')
+    || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(requestId)) throw Error('BB_OPERATOR_ENROLLMENT_LOCATION_INVALID');
+  return join(sdkDataDir, 'observation-roots', requestId + '.enrollment.json');
+}
+/** Root ID intentionally absent: normal Core assigns it AFTER this immutable payload. */
+export function nativeContextFingerprint(value: OperatorEnrollment): string {
+  const selected = value.nativeContext;
+  return sha(['bb-durable-native-context/v1', value.grantPath, value.descriptorPath,
+    selected.socket, selected.session.id, selected.session.directory, selected.session.cwd]);
+}
+/** SINGLE encoding from core/root-attach/CONTRACT.md; no normalization or caller-supplied hash. */
+export function attachmentPayloadFingerprint(value: OperatorEnrollment): string {
+  return sha(['bb-native-root-attachment/v1', value.requestId, value.hostId, value.projectId,
+    value.environmentId, value.providerId, nativeContextFingerprint(value)]);
+}
+async function validateLocalContext(sdkDataDir: string, config: OperatorGrantConfig, snapshot?: unknown): Promise<SelectedNativeSession> {
+  await assertPrivateOwnerParent(config.grantPath);
+  const selected = await readSelectedNativeSession(config.descriptorPath);
+  if (snapshot !== undefined && !isDeepStrictEqual(snapshot, selected)) throw Error('BB_OPERATOR_ENROLLMENT_NATIVE_CONTEXT_CHANGED');
+  const within = relative(selected.session.cwd, sdkDataDir);
+  if (within === '' || (!within.startsWith('..' + '/') && within !== '..' && !isAbsolute(within)))
+    throw Error('BB_OPERATOR_ENROLLMENT_MUST_BE_OUTSIDE_WORKSPACE');
+  return selected;
+}
+/** LOCAL OS operator only. No grant/binding/Root creation or native RPC occurs. */
+export async function provisionOperatorEnrollment(sdkDataDir: string, scope: OperatorAttachmentSelectors, config: OperatorGrantConfig): Promise<OperatorEnrollment> {
+  selectors(scope);
+  const checked = operatorGrantConfig({ PI_DURABLE_OWNER_GRANT_PATH: config.grantPath, PI_DURABLE_SELECTED_SESSION_DESCRIPTOR: config.descriptorPath });
+  if (!checked) throw Error('BB_OPERATOR_ENROLLMENT_INVALID');
+  const nativeContext = await validateLocalContext(sdkDataDir, checked);
+  const value: OperatorEnrollment = Object.freeze({ protocol: 'bb-durable-operator-enrollment/v1', ...scope, ...checked, nativeContext });
+  await provisionPrivateOperatorFile(operatorEnrollmentPath(sdkDataDir, scope.requestId), value);
+  return value;
+}
+/** CURRENT authenticated daemon supplies expected Core-derived scope, never an HTTP proof boolean. */
+export async function readOperatorEnrollment(sdkDataDir: string, expected: OperatorAttachmentSelectors): Promise<OperatorEnrollment> {
+  selectors(expected);
+  const value = await readPrivateOwnerJson(operatorEnrollmentPath(sdkDataDir, expected.requestId));
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw Error('BB_OPERATOR_ENROLLMENT_INVALID');
+  const v = value as Record<string, unknown>;
+  const keys = ['protocol','requestId','hostId','projectId','environmentId','providerId','grantPath','descriptorPath','nativeContext'];
+  if (Object.keys(v).length !== keys.length || keys.some(k => !Object.hasOwn(v,k)) || v.protocol !== 'bb-durable-operator-enrollment/v1'
+    || Object.entries(expected).some(([key, item]) => v[key] !== item) || typeof v.grantPath !== 'string' || typeof v.descriptorPath !== 'string')
+    throw Error('BB_OPERATOR_ENROLLMENT_SCOPE_MISMATCH');
+  const config = operatorGrantConfig({ PI_DURABLE_OWNER_GRANT_PATH: v.grantPath, PI_DURABLE_SELECTED_SESSION_DESCRIPTOR: v.descriptorPath });
+  if (!config) throw Error('BB_OPERATOR_ENROLLMENT_INVALID');
+  const nativeContext = await validateLocalContext(sdkDataDir, config, v.nativeContext);
+  return Object.freeze({ protocol: 'bb-durable-operator-enrollment/v1', ...expected, ...config, nativeContext });
+}
diff --git a/bb-extension/bootstrap/operator-profile.ts b/bb-extension/bootstrap/operator-profile.ts
new file mode 100644
index 0000000..05843e7
--- /dev/null
+++ b/bb-extension/bootstrap/operator-profile.ts
@@ -0,0 +1,69 @@
+import { constants, lstatSync } from 'node:fs';
+import { open } from 'node:fs/promises';
+import { isDeepStrictEqual } from 'node:util';
+import { isAbsolute, join, resolve } from 'node:path';
+import { assertPrivateOwnerParent, readPrivateOwnerJson } from './owner-grant.ts';
+import { operatorGrantConfig, type OperatorGrantConfig } from './provider-grant.ts';
+
+/** ONLY the normal SDK ProviderBridgeDefinition.start(context) supplies this directory. */
+export function sdkOperatorDirectory(context: { pluginId: string; dataDir: string }): string {
+  if (!context || typeof context.pluginId !== 'string' || !context.pluginId.trim() || typeof context.dataDir !== 'string'
+    || !isAbsolute(context.dataDir) || resolve(context.dataDir) !== context.dataDir || context.dataDir.includes('\0'))
+    throw Error('BB_OPERATOR_SDK_CONTEXT_REQUIRED');
+  return context.dataDir;
+}
+export function operatorProfilePath(dataDir: string, threadId: string): string {
+  if (!/^[A-Za-z0-9_-]{1,256}$/.test(threadId)) throw Error('BB_OPERATOR_PROFILE_ROOT_ID_REQUIRED');
+  return join(dataDir, 'observation-roots', threadId + '.json');
+}
+/** Presence is a routing hint ONLY, never permission; contents are not read before Core proof. */
+export function hasOperatorProfile(dataDir: string, threadId: string): boolean {
+  try { lstatSync(operatorProfilePath(dataDir, threadId)); return true; }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false; throw error; }
+}
+/** Local OS operator writer only; no RPC or wire path calls this. Creation grants NO Core/native authority. */
+export async function provisionOperatorRootProfile(dataDir: string, threadId: string, config: OperatorGrantConfig): Promise<void> {
+  const path = operatorProfilePath(dataDir, threadId);
+  await assertPrivateOwnerParent(path);
+  const checked = operatorGrantConfig({ PI_DURABLE_OWNER_GRANT_PATH: config.grantPath,
+    PI_DURABLE_SELECTED_SESSION_DESCRIPTOR: config.descriptorPath });
+  if (!checked) throw Error('BB_OPERATOR_PROFILE_INVALID');
+  await assertPrivateOwnerParent(checked.grantPath);
+  await assertPrivateOwnerParent(checked.descriptorPath);
+  await provisionPrivateOperatorFile(path, { protocol: 'bb-durable-operator-profile/v1', threadId, ...checked });
+}
+/** Shared exclusive writer for the two actual local operator files; not an RPC/config manager. */
+export async function provisionPrivateOperatorFile(path: string, value: unknown): Promise<void> {
+  await assertPrivateOwnerParent(path);
+  const bytes = Buffer.from(JSON.stringify(value) + '\n');
+  if (bytes.length > 16 * 1024) throw Error('BB_OPERATOR_PROFILE_TOO_LARGE');
+  let handle;
+  try { handle = await open(path, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW, 0o600); }
+  catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;
+    const existing = await readPrivateOwnerJson(path);
+    if (!isDeepStrictEqual(existing, value))
+      throw Error('BB_OPERATOR_PROFILE_CONFLICT');
+    return; // Exact explicit retry, never overwrite/rebase a committed profile.
+  }
+  try {
+    const stat = await handle.stat();
+    if (!stat.isFile() || stat.uid !== process.getuid?.() || (stat.mode & 0o7777) !== 0o600 || stat.nlink !== 1)
+      throw Error('BB_OPERATOR_PROFILE_PRIVATE_FILE_REQUIRED');
+    await handle.writeFile(bytes); await handle.sync();
+  } finally { await handle.close(); } // Partial failure remains fail-closed; no deletion/replacement.
+}
+/** Private operator routing ONLY. Actual current-process confirmation/getOwnerScope must follow native rootMatch. */
+export async function readOperatorRootProfile(dataDir: string, threadId: string): Promise<OperatorGrantConfig> {
+  const value = await readPrivateOwnerJson(operatorProfilePath(dataDir, threadId));
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw Error('BB_OPERATOR_PROFILE_INVALID');
+  const v = value as Record<string, unknown>;
+  if (Object.keys(v).length !== 4 || v.protocol !== 'bb-durable-operator-profile/v1' || v.threadId !== threadId
+    || typeof v.grantPath !== 'string' || typeof v.descriptorPath !== 'string') throw Error('BB_OPERATOR_PROFILE_INVALID');
+  const config = operatorGrantConfig({ PI_DURABLE_OWNER_GRANT_PATH: v.grantPath, PI_DURABLE_SELECTED_SESSION_DESCRIPTOR: v.descriptorPath });
+  if (!config) throw Error('BB_OPERATOR_PROFILE_INVALID');
+  // The grant may not exist yet; its canonical private parent must already exist.
+  await assertPrivateOwnerParent(config.grantPath);
+  await assertPrivateOwnerParent(config.descriptorPath);
+  return config; // Frozen by the existing config reader; paths alone confer NO owner authority.
+}
diff --git a/bb-extension/bootstrap/owner-grant.ts b/bb-extension/bootstrap/owner-grant.ts
new file mode 100644
index 0000000..d4d9af6
--- /dev/null
+++ b/bb-extension/bootstrap/owner-grant.ts
@@ -0,0 +1,101 @@
+import { constants, type Stats } from 'node:fs';
+import { lstat, open, realpath } from 'node:fs/promises';
+import { dirname, isAbsolute, resolve } from 'node:path';
+type DurableBinding = { providerId: string; sessionId: string; parentThreadId: string };
+
+export const OWNER_GRANT_PROTOCOL = 'bb-durable-owner-grant/v1' as const;
+export type OwnerGrant = Readonly<{
+  protocol: typeof OWNER_GRANT_PROTOCOL;
+  ownerScope: Readonly<Required<Pick<DurableBinding, 'providerId' | 'sessionId' | 'parentThreadId'>>>;
+  socketPath: string;
+}>;
+const MAX_BYTES = 16 * 1024;
+const nonblank = (value: unknown): value is string => typeof value === 'string' && value.trim().length > 0 && value.length <= 256;
+function object(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+function exact(value: Record<string, unknown>, keys: string[]): boolean {
+  return Object.keys(value).length === keys.length && keys.every(key => Object.hasOwn(value, key));
+}
+function absolute(path: unknown): asserts path is string {
+  if (typeof path !== 'string' || path.includes('\0') || !isAbsolute(path) || resolve(path) !== path)
+    throw Error('OWNER_GRANT_ABSOLUTE_CANONICAL_PATH_REQUIRED');
+}
+function validated(value: unknown): OwnerGrant {
+  if (!object(value) || !exact(value, ['protocol', 'ownerScope', 'socketPath']) || value.protocol !== OWNER_GRANT_PROTOCOL
+    || !object(value.ownerScope) || !exact(value.ownerScope, ['providerId', 'sessionId', 'parentThreadId'])
+    || !nonblank(value.ownerScope.providerId) || !nonblank(value.ownerScope.sessionId) || !nonblank(value.ownerScope.parentThreadId))
+    throw Error('OWNER_GRANT_INVALID');
+  absolute(value.socketPath);
+  return Object.freeze({ protocol: OWNER_GRANT_PROTOCOL,
+    ownerScope: Object.freeze({ providerId: value.ownerScope.providerId, sessionId: value.ownerScope.sessionId,
+      parentThreadId: value.ownerScope.parentThreadId }), socketPath: value.socketPath });
+}
+export async function assertPrivateOwnerParent(path: string): Promise<number> {
+  absolute(path);
+  const uid = process.getuid?.();
+  if (process.platform !== 'linux' || uid === undefined || !constants.O_NOFOLLOW) throw Error('OWNER_GRANT_PLATFORM_UNSUPPORTED');
+  const parent = dirname(path);
+  const stat = await lstat(parent);
+  if (!stat.isDirectory() || stat.isSymbolicLink() || stat.uid !== uid || (stat.mode & 0o7777) !== 0o700
+    || await realpath(parent) !== parent) throw Error('OWNER_GRANT_PRIVATE_PARENT_REQUIRED');
+  return uid;
+}
+function privateFile(stat: Stats, uid: number) {
+  if (!stat.isFile() || stat.uid !== uid || (stat.mode & 0o7777) !== 0o600 || stat.nlink !== 1 || stat.size > MAX_BYTES)
+    throw Error('OWNER_GRANT_PRIVATE_FILE_REQUIRED');
+}
+
+/**
+ * Read an explicitly trusted operator/provisioner path. File ownership is NOT
+ * evidence that a BB daemon authenticated the owner tuple. No default discovery,
+ * network, storage, host bind or automatic pairing occurs here.
+ */
+export async function readPrivateOwnerJson(path: string): Promise<unknown> {
+  const uid = await assertPrivateOwnerParent(path);
+  const handle = await open(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+  try {
+    const before = await handle.stat();
+    privateFile(before, uid);
+    const buffer = Buffer.alloc(MAX_BYTES + 1);
+    let length = 0;
+    for (;;) {
+      const { bytesRead } = await handle.read(buffer, length, buffer.length - length, null);
+      length += bytesRead;
+      if (length > MAX_BYTES) throw Error('OWNER_GRANT_TOO_LARGE');
+      if (!bytesRead) break;
+    }
+    const after = await handle.stat();
+    privateFile(after, uid);
+    if (before.size !== length || after.size !== length || before.mtimeMs !== after.mtimeMs || before.ctimeMs !== after.ctimeMs)
+      throw Error('OWNER_GRANT_CHANGED_DURING_READ');
+    return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(buffer.subarray(0, length)));
+  } finally { await handle.close(); }
+}
+
+export async function readOwnerGrant(path: string): Promise<OwnerGrant> {
+  const grant = validated(await readPrivateOwnerJson(path));
+  await assertPrivateOwnerParent(grant.socketPath);
+  return grant;
+}
+
+/**
+ * Controlled-start provisioning ONLY. Caller must already possess trusted scope.
+ * Exclusive creation never overwrites, chmods or deletes an existing path. A
+ * failed write may retain a private incomplete file; readers always fail closed.
+ */
+export async function provisionOwnerGrant(path: string, value: OwnerGrant): Promise<OwnerGrant> {
+  const grant = validated(value);
+  const uid = await assertPrivateOwnerParent(path);
+  await assertPrivateOwnerParent(grant.socketPath);
+  const serialized = Buffer.from(JSON.stringify(grant) + '\n');
+  if (serialized.length > MAX_BYTES) throw Error('OWNER_GRANT_TOO_LARGE');
+  const handle = await open(path, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | constants.O_NOFOLLOW, 0o600);
+  try {
+    privateFile(await handle.stat(), uid);
+    await handle.writeFile(serialized);
+    await handle.sync();
+    privateFile(await handle.stat(), uid);
+    return grant;
+  } finally { await handle.close(); }
+}
diff --git a/bb-extension/bootstrap/provider-grant.ts b/bb-extension/bootstrap/provider-grant.ts
new file mode 100644
index 0000000..63703d1
--- /dev/null
+++ b/bb-extension/bootstrap/provider-grant.ts
@@ -0,0 +1,100 @@
+import { createHash } from 'node:crypto';
+import { createConnection } from 'node:net';
+import { lstat, realpath } from 'node:fs/promises';
+import { basename, resolve } from 'node:path';
+import { assertPrivateOwnerParent, provisionOwnerGrant, readOwnerGrant, readPrivateOwnerJson, OWNER_GRANT_PROTOCOL, type OwnerGrant } from './owner-grant.ts';
+
+export type OperatorGrantConfig = Readonly<{ grantPath: string; descriptorPath: string }>;
+export type ProviderOwnerScope = Readonly<{ providerId: string; threadId: string; providerThreadId: string; parentThreadId: string | null }>; 
+export type SelectedNativeSession = Readonly<{ socket: string; session: { id: string; directory: string; cwd: string } }>;
+const text = (value: unknown): value is string => typeof value === 'string' && value.trim().length > 0;
+const record = (value: unknown): value is Record<string, unknown> => !!value && typeof value === 'object' && !Array.isArray(value);
+export function operatorGrantConfig(env: NodeJS.ProcessEnv = process.env): OperatorGrantConfig | undefined {
+  const grantPath = env.PI_DURABLE_OWNER_GRANT_PATH;
+  const descriptorPath = env.PI_DURABLE_SELECTED_SESSION_DESCRIPTOR;
+  if (grantPath === undefined && descriptorPath === undefined) return undefined;
+  if (!text(grantPath) || !text(descriptorPath) || resolve(grantPath) !== grantPath || resolve(descriptorPath) !== descriptorPath
+    || basename(descriptorPath) !== 'shared-host.json') throw Error('BB_OWNER_OPERATOR_PATHS_REQUIRED');
+  return Object.freeze({ grantPath, descriptorPath });
+}
+export function stableRootProviderId(threadId: string): string {
+  if (!text(threadId)) throw Error('BB_OWNER_THREAD_REQUIRED');
+  return `pi_durable_bb_${createHash('sha256').update(threadId).digest('hex')}`;
+}
+export function ownerScopeFrom(value: unknown): ProviderOwnerScope {
+  if (!record(value) || Object.keys(value).length !== 4 || !text(value.providerId) || !text(value.threadId) || !text(value.providerThreadId)
+    || (value.parentThreadId !== null && !text(value.parentThreadId)))
+    throw Error('BB_OWNER_SCOPE_UNCONFIRMED');
+  return Object.freeze({ providerId: value.providerId, threadId: value.threadId, providerThreadId: value.providerThreadId, parentThreadId: value.parentThreadId });
+}
+export async function readSelectedNativeSession(path: string): Promise<SelectedNativeSession> {
+  const value = await readPrivateOwnerJson(path);
+  if (!record(value) || Object.keys(value).length !== 3 || value.protocol !== 'bb-durable-selected-session/v1'
+    || !text(value.socket) || !record(value.session) || Object.keys(value.session).length !== 3
+    || !text(value.session.id) || !text(value.session.directory) || !text(value.session.cwd)) throw Error('BB_OWNER_NATIVE_DESCRIPTOR_INVALID');
+  const uid = await assertPrivateOwnerParent(value.socket);
+  const socket = await lstat(value.socket);
+  if (!socket.isSocket() || socket.uid !== uid || (socket.mode & 0o7777) !== 0o600) throw Error('BB_OWNER_NATIVE_SOCKET_REQUIRED');
+  if (await realpath(value.session.directory) !== value.session.directory || await realpath(value.session.cwd) !== value.session.cwd)
+    throw Error('BB_OWNER_NATIVE_CANONICAL_PATH_REQUIRED');
+  return Object.freeze({ socket: value.socket, session: Object.freeze({ id: value.session.id, directory: value.session.directory, cwd: value.session.cwd }) });
+}
+export async function verifyNativeReady(selected: SelectedNativeSession, ready: unknown, state: unknown, requestedCwd: string | undefined): Promise<void> {
+  if (!record(ready) || ready.kind !== 'ready' || ready.sharedHost !== true || !record(ready.session) || !record(state)
+    || ready.session.id !== selected.session.id || ready.session.directory !== selected.session.directory || ready.session.cwd !== selected.session.cwd
+    || state.sessionId !== selected.session.id || state.cwd !== selected.session.cwd || !requestedCwd
+    || await realpath(requestedCwd) !== selected.session.cwd) throw Error('BB_OWNER_NATIVE_SESSION_MISMATCH');
+}
+
+async function requireObservationEndpoint(grant: OwnerGrant): Promise<void> {
+  try {
+    const uid = await assertPrivateOwnerParent(grant.socketPath);
+    const stat = await lstat(grant.socketPath);
+    if (!stat.isSocket() || stat.uid !== uid || (stat.mode & 0o7777) !== 0o600) throw Error('INVALID_ENDPOINT');
+    await new Promise<void>((resolveReady, reject) => {
+      const socket = createConnection(grant.socketPath);
+      const timer = setTimeout(() => { socket.destroy(); reject(Error('ENDPOINT_TIMEOUT')); }, 1000);
+      socket.once('error', reject);
+      socket.once('connect', () => { socket.destroy(); resolveReady(); });
+      socket.once('close', () => clearTimeout(timer));
+    });
+  } catch { throw Error('BB_OBSERVATION_REOPEN_REQUIRED: operator must cold-start/reopen packaged native host'); }
+}
+
+/** Called ONLY by the real provider session after read-only native verification and scoped daemon RPC. */
+export async function produceProviderOwnerGrant(args: {
+  config: OperatorGrantConfig;
+  proof: ProviderOwnerScope;
+  expected: Pick<ProviderOwnerScope, 'providerId' | 'threadId' | 'providerThreadId'>;
+  childConversationId?: string;
+}): Promise<OwnerGrant> {
+  const { config, proof, expected, childConversationId } = args;
+  if (proof.providerId !== expected.providerId || proof.threadId !== expected.threadId || proof.providerThreadId !== expected.providerThreadId)
+    throw Error('BB_OWNER_SCOPE_MISMATCH');
+  const separator = proof.providerThreadId.indexOf(':');
+  const sessionId = separator < 0 ? proof.providerThreadId : proof.providerThreadId.slice(0, separator);
+  let existing: OwnerGrant | undefined;
+  try { existing = await readOwnerGrant(config.grantPath); }
+  catch (error) { if (!error || typeof error !== 'object' || !('code' in error) || error.code !== 'ENOENT') throw error; }
+  if (childConversationId !== undefined || proof.parentThreadId !== null) {
+    if (childConversationId === undefined || proof.parentThreadId === null || !existing || existing.ownerScope.providerId !== proof.providerId
+      || existing.ownerScope.sessionId !== sessionId || existing.ownerScope.parentThreadId !== proof.parentThreadId
+      || existing.ownerScope.parentThreadId === proof.threadId) throw Error('BB_OWNER_CHILD_CANNOT_PROVISION');
+    await requireObservationEndpoint(existing);
+    return existing; // Child reuses authorized parent scope; never mints/promotes itself.
+  }
+  const desired: OwnerGrant = { protocol: OWNER_GRANT_PROTOCOL,
+    ownerScope: { providerId: proof.providerId, sessionId, parentThreadId: proof.threadId }, socketPath: config.grantPath + '.sock' };
+  if (existing) {
+    if (JSON.stringify(existing) !== JSON.stringify(desired)) throw Error('BB_OWNER_GRANT_CONFLICT');
+    await requireObservationEndpoint(existing);
+    return existing;
+  }
+  try { await provisionOwnerGrant(config.grantPath, desired); }
+  catch (error) {
+    if (!error || typeof error !== 'object' || !('code' in error) || error.code !== 'EEXIST') throw error;
+    const raced = await readOwnerGrant(config.grantPath);
+    if (JSON.stringify(raced) !== JSON.stringify(desired)) throw Error('BB_OWNER_GRANT_CONFLICT');
+  }
+  throw Error('BB_OBSERVATION_REOPEN_REQUIRED: grant prepared; operator must cold-start/reopen packaged native host');
+}
diff --git a/packages/agent-runtime/src/native-child-runtime-scope.ts b/packages/agent-runtime/src/native-child-runtime-scope.ts
