+import type { RuntimeThreadIdentityRegistry, RuntimeProviderIdentityState } from "./runtime-thread-identity.js";
+
+/** Called only after authenticated Core registration, before its receipt reaches the provider. */
+export function bindRegisteredNativeChild(
+  registry: RuntimeThreadIdentityRegistry,
+  proc: { providerId: string; identity: RuntimeProviderIdentityState },
+  input: { sessionId: string; conversationId: string },
+  result: { threadId: string },
+): void {
+  if (!result.threadId?.trim()) throw new Error("Invalid registered native child ID");
+  registry.registerThreadProvider({ providerId: proc.providerId, providerState: proc.identity, threadId: result.threadId });
+  registry.recordProviderThreadIdentity({ providerState: proc.identity, threadId: result.threadId,
+    providerThreadId: `${input.sessionId}:${input.conversationId}` });
+}
diff --git a/packages/agent-runtime/src/native-history-request.ts b/packages/agent-runtime/src/native-history-request.ts
new file mode 100644
index 0000000..e769ae6
--- /dev/null
+++ b/packages/agent-runtime/src/native-history-request.ts
@@ -0,0 +1,62 @@
+export interface NativeHistoryRequest {
+  threadId: string;
+  snapshot?: unknown;
+  expectedDigest?: string | null;
+}
+export interface ScopedNativeHistoryRequest extends NativeHistoryRequest {
+  providerId: string;
+  providerThreadId: string;
+}
+export interface NativeHistoryReceipt { threadId: string; digest: string | null; changed: boolean }
+
+/** Only the current registered provider process can choose an already-bound BB child. */
+export function dispatchNativeHistory(
+  parsed: { parsedMethod: string; parsedId: string | number; rawRequest: { params?: unknown } },
+  proc: { providerId: string; identity: { threadIds: Set<string> } },
+  registry: { getProviderThreadId(threadId: string): string | undefined; resolveProviderForThread(threadId: string): string },
+  reconcile: ((request: ScopedNativeHistoryRequest) => Promise<NativeHistoryReceipt>) | undefined,
+  result: (value: NativeHistoryReceipt) => void,
+  error: (message: string) => void,
+): boolean {
+  if (parsed.parsedMethod !== "thread/reconcileExisting") return false;
+  const body = parsed.rawRequest.params;
+  if (!body || typeof body !== "object" || Array.isArray(body)) { error("Invalid history request"); return true; }
+  const input = body as Record<string, unknown>;
+  if (Object.keys(input).some((key) => !["threadId", "snapshot", "expectedDigest"].includes(key)) ||
+    typeof input.threadId !== "string" || !input.threadId || input.threadId.length > 200 ||
+    (input.expectedDigest !== undefined && input.expectedDigest !== null && typeof input.expectedDigest !== "string")) {
+    error("Invalid history request"); return true;
+  }
+  const threadId = input.threadId;
+  const providerThreadId = registry.getProviderThreadId(threadId);
+  if (!proc.identity.threadIds.has(threadId) || !providerThreadId ||
+    registry.resolveProviderForThread(threadId) !== proc.providerId) {
+    error("History request outside provider process scope"); return true;
+  }
+  if (!reconcile) { error("Native historical projection port unavailable"); return true; }
+  void Promise.resolve().then(() => reconcile({
+    threadId, providerId: proc.providerId, providerThreadId,
+    ...(input.snapshot === undefined ? {} : { snapshot: input.snapshot }),
+    ...(input.expectedDigest === undefined ? {} : { expectedDigest: input.expectedDigest as string | null }),
+  })).then(result, () => error("Native historical projection refused"));
+  return true;
+}
+
+/** Uses the daemon's existing authenticated server transport, not provider-supplied credentials. */
+export function createNativeHistoryClient(options: {
+  serverUrl: string; hostKey: string; serverHeaders?: Record<string, string>; fetchFn?: typeof fetch;
+}): (request: ScopedNativeHistoryRequest) => Promise<NativeHistoryReceipt> {
+  return async (request) => {
+    const response = await (options.fetchFn ?? fetch)(new URL("/internal/hosts/threads/reconcile-existing", options.serverUrl), {
+      method: "POST", headers: { ...options.serverHeaders, authorization: `Bearer ${options.hostKey}`, "content-type": "application/json" },
+      body: JSON.stringify(request), signal: AbortSignal.timeout(10000),
+    });
+    if (!response.ok) throw new Error(`Native historical projection refused (${response.status})`);
+    const value = await response.json() as NativeHistoryReceipt;
+    if (value.threadId !== request.threadId || typeof value.changed !== "boolean" ||
+      (value.digest !== null && (typeof value.digest !== "string" || !/^[a-f0-9]{64}$/.test(value.digest)))) {
+      throw new Error("Invalid history receipt");
+    }
+    return value;
+  };
+}
diff --git a/packages/agent-runtime/src/native-owner-scope.ts b/packages/agent-runtime/src/native-owner-scope.ts
new file mode 100644
index 0000000..8d35d3e
--- /dev/null
+++ b/packages/agent-runtime/src/native-owner-scope.ts
@@ -0,0 +1,67 @@
+export interface OwnerScope { providerId: string; threadId: string; providerThreadId: string; parentThreadId: string | null }
+export interface OwnerScopeQuery { providerId: string; threadId: string; providerThreadId: string; processGeneration?: string }
+const text = (value: unknown): value is string => typeof value === "string" && !!value.trim() && value.length <= 1025;
+function validScope(value: unknown, request: OwnerScopeQuery): value is OwnerScope {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return false;
+  const result = value as OwnerScope;
+  return Object.keys(result).sort().join(",") === "parentThreadId,providerId,providerThreadId,threadId" &&
+    result.providerId === request.providerId && result.threadId === request.threadId && result.providerThreadId === request.providerThreadId &&
+    (result.parentThreadId === null || (text(result.parentThreadId) && result.parentThreadId !== result.threadId));
+}
+
+/** Reverse request accepts ONLY providerThreadId; no ID syntax ever determines ancestry. */
+export function dispatchOwnerScope(
+  parsed: { parsedMethod: string; rawRequest: { params?: unknown } },
+  proc: { providerId: string; identity: { threadIds: Set<string> } },
+  registry: { getProviderThreadId(threadId: string): string | undefined; resolveProviderForThread(threadId: string): string },
+  isCurrent: () => boolean,
+  read: ((request: OwnerScopeQuery) => Promise<OwnerScope>) | undefined,
+  result: (value: OwnerScope) => void, error: (message: string) => void,
+  processGeneration?: string,
+): boolean {
+  if (parsed.parsedMethod !== "thread/getOwnerScope") return false;
+  const deny = () => error("Owner scope unavailable");
+  const input = parsed.rawRequest.params;
+  if (!input || typeof input !== "object" || Array.isArray(input) || Object.keys(input).join(",") !== "providerThreadId" ||
+    !text((input as { providerThreadId?: unknown }).providerThreadId)) { deny(); return true; }
+  const providerThreadId = (input as { providerThreadId: string }).providerThreadId;
+  let threadId: string;
+  try {
+    const matches = [...proc.identity.threadIds].filter(id => registry.getProviderThreadId(id) === providerThreadId);
+    if (!isCurrent() || matches.length !== 1 || registry.resolveProviderForThread(matches[0]!) !== proc.providerId || !read) { deny(); return true; }
+    threadId = matches[0]!;
+  } catch { deny(); return true; }
+  const query = { providerId: proc.providerId, threadId, providerThreadId,
+    ...(processGeneration ? { processGeneration } : {}) };
+  void Promise.resolve().then(() => read!(query)).then(value => {
+    try {
+      if (!isCurrent() || !proc.identity.threadIds.has(threadId) || registry.getProviderThreadId(threadId) !== providerThreadId ||
+        registry.resolveProviderForThread(threadId) !== proc.providerId || !validScope(value, query)) { deny(); return; }
+      result(value);
+    } catch { deny(); }
+  }, deny);
+  return true;
+}
+
+/** Flush is an ACK barrier for prior admitted events, NOT a new identity write/admission. */
+export async function ownerScopeAfterIdentityAck(
+  sink: { flush(): Promise<void>; listUndeliveredThreadIds(): string[] },
+  read: (request: OwnerScopeQuery) => Promise<OwnerScope>, query: OwnerScopeQuery,
+): Promise<OwnerScope> {
+  await sink.flush();
+  if (sink.listUndeliveredThreadIds().includes(query.threadId)) throw Error("Owner identity not acknowledged");
+  return read(query);
+}
+
+export function createOwnerScopeClient(options: { serverUrl: string; hostKey: string; serverHeaders?: Record<string, string>; fetchFn?: typeof fetch }) {
+  return async (query: OwnerScopeQuery): Promise<OwnerScope> => {
+    const response = await (options.fetchFn ?? fetch)(new URL("/internal/hosts/threads/owner-scope", options.serverUrl), {
+      method: "POST", headers: { ...options.serverHeaders, authorization: `Bearer ${options.hostKey}`, "content-type": "application/json" },
+      body: JSON.stringify(query), signal: AbortSignal.timeout(10000),
+    });
+    if (!response.ok) throw Error(`Owner scope unavailable (${response.status})`);
+    const value: unknown = await response.json();
+    if (!validScope(value, query)) throw Error("Invalid owner scope acknowledgement");
+    return value;
+  };
+}
diff --git a/packages/agent-runtime/src/native-root-attachment.ts b/packages/agent-runtime/src/native-root-attachment.ts
new file mode 100644
index 0000000..df5c802
--- /dev/null
+++ b/packages/agent-runtime/src/native-root-attachment.ts
@@ -0,0 +1,122 @@
+import { randomUUID } from "node:crypto";
+import { lstat } from "node:fs/promises";
+import { ensurePluginProcessDataDir } from "@bb/process-utils";
+import { readOperatorEnrollment, attachmentPayloadFingerprint, operatorEnrollmentPath, readPrivateOwnerJson, operatorProfilePath } from "@bb/host-daemon-contract";
+import { rootChallengeSchema, rootOperatorProfileSchema, rootProfileFingerprint, rootAttachmentContextSchema,
+  confirmRootAttachmentSchema, type RootAttachmentContext } from "@bb/host-daemon-contract";
+
+export interface RootConfirmationAttempt {
+  attemptId: string;
+  daemonSessionId: string;
+}
+export interface RootConfirmationRequest extends RootConfirmationAttempt {
+  threadId: string;
+  providerId: string;
+  providerThreadId: string;
+  enrollmentFingerprint: string;
+  rootProfileFingerprint: string;
+  processGeneration: string;
+}
+
+export function createRootConfirmationClient(options: {
+  serverUrl: string; hostKey: string; serverHeaders?: Record<string, string>; fetchFn?: typeof fetch;
+}) {
+  return async (request: RootConfirmationRequest): Promise<{threadId: string}> => {
+    const response = await (options.fetchFn ?? fetch)(new URL('/internal/hosts/threads/confirm-root-attachment', options.serverUrl), {
+      method: 'POST', redirect: 'error',
+      headers: {...options.serverHeaders, authorization: `Bearer ${options.hostKey}`, 'content-type': 'application/json'},
+      body: JSON.stringify(request), signal: AbortSignal.timeout(10000),
+    });
+    if (!response.ok) throw Error('Root attachment confirmation refused');
+    const value: unknown = await response.json();
+    if (!value || typeof value !== 'object' || Object.keys(value).join(',') !== 'threadId' ||
+      (value as {threadId?: unknown}).threadId !== request.threadId) throw Error('Invalid root attachment confirmation');
+    return {threadId: request.threadId};
+  };
+}
+
+const generations = new WeakMap<object,string>();
+export function rootProcessGeneration(proc: object): string {
+  let value=generations.get(proc); if(!value){value=randomUUID();generations.set(proc,value);} return value;
+}
+function missing(error: unknown): boolean { return !!error && typeof error === "object" && "code" in error && error.code === "ENOENT"; }
+async function exists(path: string): Promise<boolean> { try { await lstat(path); return true; } catch(error){if(missing(error))return false;throw error;} }
+
+/** Called ONLY from actual authenticated normal daemon command dispatch, never caller providerOptions. */
+export async function handleRootAttachmentChallenge(args: {
+  challenge: unknown; pluginId: string; applicationDataDir: string;
+  start: (context: RootAttachmentContext, attempt: RootConfirmationAttempt) => Promise<{processGeneration:string}>;
+}) {
+  const c=rootChallengeSchema.parse(args.challenge);
+  const bridgeDataDir=await ensurePluginProcessDataDir({daemonDataDir:args.applicationDataDir,pluginId:args.pluginId,kind:"bridge-data"});
+  const enrollmentFile=operatorEnrollmentPath(bridgeDataDir,c.request.requestId);
+  if(!await exists(enrollmentFile)) {
+    if(c.phase!=="enrollment")throw Error("ROOT_ENROLLMENT_MISSING");
+    return {status:"enrollment-required" as const,challengeId:c.challengeId,enrollmentFile};
+  }
+  const enrollment=await readOperatorEnrollment(bridgeDataDir,{...c.request,hostId:c.hostId});
+  const enrollmentFingerprint=attachmentPayloadFingerprint(enrollment);
+  if(c.enrollmentFingerprint!==undefined && c.enrollmentFingerprint!==enrollmentFingerprint)throw Error("ROOT_ENROLLMENT_CHANGED");
+  const base={status:"validated" as const,challengeId:c.challengeId,hostId:c.hostId,request:c.request,
+    enrollment,enrollmentFingerprint,enrollmentFile};
+  if(c.phase==="enrollment")return base;
+  const threadId=c.threadId!;
+  const profileFile=operatorProfilePath(bridgeDataDir,threadId);
+  if(!await exists(profileFile)) {
+    if(c.phase==="start")throw Error("ROOT_PROFILE_MISSING");
+    return {...base,profileFile};
+  }
+  const profile=rootOperatorProfileSchema.parse(await readPrivateOwnerJson(profileFile));
+  if(profile.threadId!==threadId || profile.grantPath!==enrollment.grantPath || profile.descriptorPath!==enrollment.descriptorPath)
+    throw Error("ROOT_PROFILE_ENROLLMENT_MISMATCH");
+  const fingerprint=rootProfileFingerprint(threadId,enrollmentFingerprint,profile);
+  const proof={...base,profileFile,profile,rootProfileFingerprint:fingerprint};
+  if(c.phase==="profile")return proof;
+  if(fingerprint!==c.rootProfileFingerprint)throw Error("ROOT_PROFILE_CHANGED");
+  const context=rootAttachmentContextSchema.parse({protocol:"bb-native-root-admission/v1",...c.request,threadId,
+    hostId:c.hostId,enrollmentFingerprint,rootProfileFingerprint:fingerprint});
+  const started=await args.start(context,{attemptId:c.challengeId,daemonSessionId:c.daemonSessionId});
+  return {...proof,processGeneration:started.processGeneration};
+}
+
+/** Reserved carrier applied AFTER the normal adapter has assembled/options-merged its request. */
+export function rootAttachmentPlan<T extends {kind:string;method?:string;params?:unknown}>(
+  plan:T, value:unknown, threadId:string,
+):T {
+  if(value===undefined)return plan;
+  const context=rootAttachmentContextSchema.parse(value);
+  if(context.threadId!==threadId || plan.kind!=="request" || !["thread/start","thread/resume"].includes(plan.method??"") ||
+    !plan.params || typeof plan.params!=="object" || Array.isArray(plan.params))throw Error("ROOT_ADMISSION_PLAN_MISMATCH");
+  const params=plan.params as Record<string,unknown>;
+  if(params.threadId!==threadId)throw Error("ROOT_ADMISSION_PLAN_MISMATCH");
+  return {...plan,params:{...params,bbRootAttachment:Object.freeze(context)}};
+}
+
+/** Actual reverse RPC only. Registry derives all ownership; supplied hashes are claims until Core verifies them. */
+export function dispatchRootConfirmation<Identity extends object>(parsed: {
+  parsedMethod?:string;parsedId?:unknown;rawRequest?:{params?:unknown};
+},proc:{identity:Identity},registry:{resolveBbThreadIdForProviderThread:(args:{providerState:Identity;providerThreadId:string})=>string|undefined},
+  options:{confirm:(request:RootConfirmationRequest)=>Promise<{threadId:string}>;isCurrent:()=>boolean;providerId:string;
+    getRootConfirmation:(threadId:string)=>RootConfirmationAttempt|undefined}, 
+  sendResult:(value:{threadId:string})=>void,sendError:(message:string)=>void,
+):boolean {
+  if(parsed.parsedMethod!=="thread/confirmRootAttachment")return false;
+  const checked=confirmRootAttachmentSchema.safeParse(parsed.rawRequest?.params);
+  if(!checked.success || !options.isCurrent()){sendError("Root attachment confirmation unavailable");return true;}
+  const claims=checked.data;
+  const threadId=registry.resolveBbThreadIdForProviderThread({providerState:proc.identity,providerThreadId:claims.providerThreadId});
+  const attempt=threadId?options.getRootConfirmation(threadId):undefined;
+  if(!threadId || !attempt){sendError("Root attachment confirmation unavailable");return true;}
+  const frozenAttempt={...attempt};
+  const generation=rootProcessGeneration(proc);
+  void (async()=>{
+    try {
+      if(!options.isCurrent() || registry.resolveBbThreadIdForProviderThread({providerState:proc.identity,providerThreadId:claims.providerThreadId})!==threadId)
+        throw Error("ROOT_PROCESS_REPLACED");
+      const result=await options.confirm({threadId,providerId:options.providerId,...claims,processGeneration:generation,...frozenAttempt});
+      if(!options.isCurrent() || result.threadId!==threadId)throw Error("ROOT_PROCESS_REPLACED");
+      sendResult(result);
+    } catch {sendError("Root attachment confirmation refused");}
+  })();
+  return true;
+}
diff --git a/packages/db/src/data/native-history.ts b/packages/db/src/data/native-history.ts
new file mode 100644
index 0000000..bdb0417
--- /dev/null
+++ b/packages/db/src/data/native-history.ts
@@ -0,0 +1,226 @@
+import { createHash } from "node:crypto";
+import { isDeepStrictEqual } from "node:util";
+
+import type { HistoricalSnapshot } from "@bb/domain";
+export type { HistoricalSnapshot } from "@bb/domain";
+
+export const HISTORY_PLUGIN = "bb.core.native-history";
+export const REGISTRATION_PLUGIN = "bb.core.native-registration";
+const hash = (value: unknown) => createHash("sha256").update(JSON.stringify(value)).digest("hex");
+
+/** Inject existing BB repository helpers so the same implementation runs in matched bundles. */
+export interface NativeHistoryCore {
+  getThread: typeof import("@bb/db").getThread;
+  getEnvironment: typeof import("@bb/db").getEnvironment;
+  getThreadPluginMetadata: typeof import("@bb/db").getThreadPluginMetadata;
+  appendStoredThreadEventsInTransaction: typeof import("@bb/db").appendStoredThreadEventsInTransaction;
+  events: typeof import("@bb/db").events;
+  threads: typeof import("@bb/db").threads;
+  parseStoredThreadEvent: typeof import("@bb/domain").parseStoredThreadEvent;
+  toStoredThreadEventData: (event: ReturnType<NativeHistoryCore["parseStoredThreadEvent"]>) => Record<string, unknown>;
+  threadSearchSegments: typeof import("@bb/db").threadSearchSegments;
+  threadPluginMetadata: typeof import("@bb/db").threadPluginMetadata;
+  eq: typeof import("drizzle-orm").eq;
+  and: typeof import("drizzle-orm").and;
+  inArray: typeof import("drizzle-orm").inArray;
+  bumpThreadEventRewriteGeneration: (threadId: string) => void;
+}
+
+export interface NativeHistoryInput {
+  threadId: string;
+  providerId: string;
+  providerThreadId: string;
+  expectedDigest?: string | null;
+  snapshot?: HistoricalSnapshot;
+}
+export interface NativeHistoryResult { threadId: string; digest: string | null; changed: boolean; deferred?: true; turnId?: string }
+export class NativeHistoryError extends Error {
+  constructor(readonly status: 400 | 404 | 409, message: string) { super(message); }
+}
+
+/** Provenance only, after Core authorization; this predicate grants no rights. */
+export function nativeControlWasAdmitted(control: { requestId: string; input: unknown }, snapshot: HistoricalSnapshot): boolean {
+  const receipt = snapshot.inputs?.find(receipt => receipt.requestId === `bb-child:${control.requestId}`);
+  const nativeText = receipt && snapshot.items.filter(item => item.source.entryId === receipt.entryId && item.item.type === 'userMessage')
+    .flatMap(item => item.item.type === 'userMessage' ? item.item.content.map(block => block.text) : []).join('\n').trim();
+  const controlText = Array.isArray(control.input) && control.input.every(block => block?.type === 'text' && typeof block.text === 'string')
+    ? control.input.map(block => block.text).join('\n').trim() : undefined;
+  return receipt !== undefined && nativeText === controlText;
+}
+
+export function reconcileNativeHistory(
+  db: import("@bb/db").DbConnection,
+  hostId: string,
+  input: NativeHistoryInput,
+  core: NativeHistoryCore,
+): NativeHistoryResult {
+  const { eq, inArray, events, threadSearchSegments } = core;
+  const result = db.transaction((tx) => {
+    // All identity/ownership checks happen inside the write transaction, before history reads.
+    const thread = core.getThread(tx, input.threadId);
+    const binding = core.getThreadPluginMetadata(tx, input.threadId, REGISTRATION_PLUGIN);
+    const b = binding.metadata;
+    const parent = typeof b.parentThreadId === "string" ? core.getThread(tx, b.parentThreadId) : undefined;
+    const environment = thread?.environmentId ? core.getEnvironment(tx, thread.environmentId) : undefined;
+    if (!thread || thread.deletedAt !== null || thread.archivedAt !== null || binding.corrupt ||
+      b.kind !== "native-existing" || b.hostId !== hostId || b.providerId !== input.providerId ||
+      input.providerThreadId !== `${b.sessionId}:${b.conversationId}` ||
+      thread.providerId !== input.providerId || !parent || parent.deletedAt !== null || parent.archivedAt !== null ||
+      thread.parentThreadId !== parent.id || thread.environmentId !== parent.environmentId ||
+      !environment || environment.hostId !== hostId) {
+      throw new NativeHistoryError(404, "Registered native child not found in requester scope");
+    }
+    const receipt = core.getThreadPluginMetadata(tx, input.threadId, HISTORY_PLUGIN);
+    const old = receipt.metadata;
+    if (receipt.corrupt || (old.digest !== undefined && (typeof old.digest !== "string" || old.version !== 1))) {
+      throw new NativeHistoryError(409, "Corrupt native history ownership metadata");
+    }
+    const digest = typeof old.digest === "string" ? old.digest : null;
+    const stored = tx.select().from(events).where(eq(events.threadId, input.threadId)).orderBy(events.sequence).all();
+    const controlRows: typeof stored = [];
+    const rejectedRequests = new Set<string>();
+    // Core records transport loss without consulting the external native owner.
+    // Retain that exact lifecycle batch, but never mistake its synthetic turn
+    // interruption for native transcript mutation or native execution outcome.
+    const lifecycleData = (row: typeof stored[number]): Record<string, unknown> | undefined => {
+      const hostDisconnect = row.type === 'system/thread/interrupted' && row.scopeKind === 'thread';
+      if ((row.environmentId !== thread.environmentId && !(hostDisconnect && row.environmentId === null))
+        || (row.providerThreadId !== null && row.providerThreadId !== input.providerThreadId) || row.itemId !== null || row.itemKind !== null || row.parentToolCallId !== null) return;
+      if (row.scopeKind !== 'thread' && row.scopeKind !== 'turn' || row.scopeKind === 'thread' && row.turnId !== null
+        || row.scopeKind === 'turn' && !row.turnId) return;
+      try {
+        const data = JSON.parse(row.data);
+        const scope = row.scopeKind === 'thread' ? { kind: 'thread' as const } : { kind: 'turn' as const, turnId: row.turnId! };
+        const event = core.parseStoredThreadEvent({ type: row.type, threadId: input.threadId, scope, data });
+        if (('providerThreadId' in event && event.providerThreadId !== input.providerThreadId)
+          || !isDeepStrictEqual(data, core.toStoredThreadEventData(event))) return;
+        return data;
+      } catch { return; }
+    };
+    const disconnects = stored.filter(row => row.type === 'system/thread/interrupted' && row.scopeKind === 'thread'
+      && lifecycleData(row)?.reason === 'host-daemon-restarted');
+    const disconnectTimes = new Set(disconnects.map(row => Number(row.createdAt)).filter(Number.isSafeInteger));
+    const disconnectErrors = stored.filter(row => {
+      if (row.type !== 'system/error' || !disconnectTimes.has(Number(row.createdAt))) return false;
+      const data = lifecycleData(row);
+      return data?.code === 'thread_command_failed' && data.message === 'Thread interrupted because the host daemon disconnected'
+        && data.detail === 'Please retry the thread to continue.';
+    });
+    const interruptedTurns = new Set(disconnectErrors.filter(row => row.scopeKind === 'turn')
+      .map(row => JSON.stringify([Number(row.createdAt), row.turnId])));
+    const lifecycleIds = new Set([...disconnects, ...disconnectErrors, ...stored.filter(row => row.type === 'turn/completed'
+      && interruptedTurns.has(JSON.stringify([Number(row.createdAt), row.turnId])) && lifecycleData(row)?.status === 'interrupted')].map(row => row.id));
+    const rows = stored.filter((row) => {
+      if (lifecycleIds.has(row.id)) return false;
+      let commandError = false;
+      if (row.type === 'system/error') {
+        try { commandError = JSON.parse(row.data).code === 'thread_command_failed'; } catch { /* Mixed malformed rows remain protected. */ }
+      }
+      if (row.type === 'client/turn/requested' || row.type === 'client/turn/rejected' || commandError) {
+        if (row.environmentId !== thread.environmentId || (row.providerThreadId !== null && row.providerThreadId !== input.providerThreadId)
+          || row.scopeKind !== 'thread' || row.turnId !== null || row.itemId !== null || row.itemKind !== null || row.parentToolCallId !== null)
+          throw new NativeHistoryError(409, 'Foreign native control bookkeeping');
+        try {
+          const data = JSON.parse(row.data);
+          const event = core.parseStoredThreadEvent({ type: row.type, threadId: input.threadId, scope: { kind: 'thread' }, data });
+          const canonical = core.toStoredThreadEventData(event);
+          // Core's client-event writer omits decoder defaults (mentions/system
+          // labels). Validate its schema, but don't require absent defaults.
+          if (Object.keys(data).some(key => !Object.hasOwn(canonical, key))) throw Error('Unknown control fields');
+        } catch { throw new NativeHistoryError(409, 'Malformed native control bookkeeping'); }
+        if (row.type === 'client/turn/requested') controlRows.push(row);
+        if (row.type === 'client/turn/rejected') rejectedRequests.add(JSON.parse(row.data).requestId);
+        return false;
+      }
+      // Only these exact canonical, correctly scoped non-transcript events may coexist.
+      // A prefix or parse failure must never turn unknown/live data into bookkeeping.
+      if (row.type !== "thread/identity" && row.type !== "provider.env-resolved") return true;
+      if (row.environmentId !== thread.environmentId || row.providerThreadId !== input.providerThreadId ||
+        row.scopeKind !== "thread" || row.turnId !== null || row.itemId !== null ||
+        row.itemKind !== null || row.parentToolCallId !== null) {
+        throw new NativeHistoryError(409, "Malformed or foreign history bookkeeping");
+      }
+      try {
+        const data: Record<string, unknown> = JSON.parse(row.data);
+        if (!data || typeof data !== "object" || Array.isArray(data)) throw new Error("Nonobject bookkeeping");
+        const event = core.parseStoredThreadEvent({ type: row.type, threadId: input.threadId,
+          scope: { kind: "thread" }, data });
+        if (!("providerThreadId" in event) || event.providerThreadId !== input.providerThreadId ||
+          !isDeepStrictEqual(data, core.toStoredThreadEventData(event))) throw new Error("Noncanonical bookkeeping");
+      } catch {
+        throw new NativeHistoryError(409, "Malformed or foreign history bookkeeping");
+      }
+      return false;
+    });
+    // Both getDigest and apply validate the owned transcript fingerprint. Bookkeeping
+    // remains byte-for-byte untouched and does not change the transcript CAS domain.
+    if ((digest === null && rows.length !== 0) ||
+      (digest !== null && (old.rowCount !== rows.length || old.rowsDigest !== hash(rows)))) {
+      throw new NativeHistoryError(409, "Mixed or modified history cannot be replaced");
+    }
+    if (input.snapshot === undefined) return { threadId: input.threadId, digest, changed: false };
+    const snapshot = input.snapshot;
+    const identity = [b.hostId, b.providerId, b.sessionId, b.conversationId, input.threadId];
+    const nextDigest = hash([identity, snapshot, "historical-origin-v3"]);
+    const lastInput = [...snapshot.items].reverse().find(entry => entry.item.type === 'userMessage')?.source.entryId ?? null;
+    const turnId = `nh-t-${hash([identity, lastInput])}`; // BB presentation, not a native run ID.
+    if (digest === nextDigest && !controlRows.length) return { threadId: input.threadId, digest, changed: false, turnId };
+    if (input.expectedDigest !== digest) throw new NativeHistoryError(409, "Native history changed; stale snapshot refused");
+    // Core records the UI command before native admission. Never remove it or
+    // clear active status until the native receipt AND exact input agree.
+    const admittedControls: typeof stored = [];
+    for (const row of controlRows) {
+      const control = JSON.parse(row.data);
+      if (nativeControlWasAdmitted(control, snapshot)) admittedControls.push(row);
+      else if (!rejectedRequests.has(control.requestId)) return { threadId: input.threadId, digest, changed: false, deferred: true as const };
+      // Rejected/unconfirmed attempts stay verbatim, including their errors.
+      // Only an actual native receipt can replace their original UI request.
+    }
+    if (digest === nextDigest && !admittedControls.length) return { threadId: input.threadId, digest, changed: false, turnId };
+    if (!["pending", "idle", "error"].includes(thread.status)
+      && !(thread.status === 'active' && (admittedControls.length > 0 || old.nativeStatus === 'working'))) {
+      throw new NativeHistoryError(409, "Cannot replace history of an executing BB thread");
+    }
+    const scope = { kind: "turn" as const, turnId };
+    const base = { threadId: input.threadId, environmentId: thread.environmentId, providerThreadId: input.providerThreadId, scope };
+    const eventArgs: Parameters<NativeHistoryCore["appendStoredThreadEventsInTransaction"]>[1][number][] = [];
+    if (snapshot.items.length > 0) {
+      eventArgs.push({ ...base, type: "turn/started", data: { providerThreadId: input.providerThreadId } });
+      for (const entry of snapshot.items) {
+        const id = `nh-i-${hash([identity, entry.source.entryId, entry.source.messageIndex, entry.source.blockIndex])}`;
+        const item = { ...entry.item, id };
+        eventArgs.push({ ...base, type: entry.item.type === 'toolCall' && entry.item.status === 'pending' ? 'item/started' : 'item/completed',
+          data: { providerThreadId: input.providerThreadId, item } });
+      }
+      if (snapshot.status !== 'working') eventArgs.push({ ...base, type: "turn/completed", data: { providerThreadId: input.providerThreadId, status: snapshot.status } });
+    }
+    const reasoning = snapshot.agent?.thinkingLevel === 'off' ? 'none' : snapshot.agent?.thinkingLevel;
+    tx.update(core.threads).set({ status: snapshot.status === 'working' ? 'active' : snapshot.status === "failed" ? "error" : "idle",
+      // A registered child has no synthetic thread/start execution. Use its
+      // authoritative native model for Core's composer/dispatch metadata only.
+      ...(snapshot.agent ? { modelOverride: snapshot.agent.model } : {}),
+      ...(reasoning && ['none', 'low', 'medium', 'high', 'xhigh', 'ultracode', 'max', 'ultra'].includes(reasoning)
+        ? { reasoningLevelOverride: reasoning } : {}),
+    }).where(eq(core.threads.id, input.threadId)).run();
+    // Append before removal retains increasing sequence numbers for changed nonempty snapshots.
+    core.appendStoredThreadEventsInTransaction(tx, eventArgs);
+    const replaced = [...rows, ...admittedControls];
+    if (replaced.length > 0) {
+      tx.delete(threadSearchSegments).where(core.and(eq(threadSearchSegments.threadId, input.threadId),
+        inArray(threadSearchSegments.sourceSeq, replaced.map((row) => row.sequence)))).run();
+      tx.delete(events).where(inArray(events.id, replaced.map((row) => row.id))).run();
+    }
+    const retained = new Set(stored.filter((row) => !replaced.includes(row)).map((row) => row.id));
+    const finalRows = tx.select().from(events).where(eq(events.threadId, input.threadId)).orderBy(events.sequence).all()
+      .filter((row) => !retained.has(row.id));
+    // Same existing namespace upsert as patchThreadPluginMetadata, but inside this transaction.
+    // Its public helper takes DbConnection, not DbTransaction; the bounded receipt is <1KiB.
+    const metadataJson = JSON.stringify({ version: 1, digest: nextDigest, nativeStatus: snapshot.status, rowCount: finalRows.length, rowsDigest: hash(finalRows) });
+    tx.insert(core.threadPluginMetadata).values({ threadId: input.threadId, pluginId: HISTORY_PLUGIN, metadataJson })
+      .onConflictDoUpdate({ target: [core.threadPluginMetadata.threadId, core.threadPluginMetadata.pluginId], set: { metadataJson } }).run();
+    return { threadId: input.threadId, digest: nextDigest, changed: true, turnId };
+  }, { behavior: "immediate" });
+  // No live event ingestion/effects, queue admission, or model callbacks.
+  if (result.changed) core.bumpThreadEventRewriteGeneration(input.threadId);
+  return result;
+}
diff --git a/packages/domain/src/native-history-contract.ts b/packages/domain/src/native-history-contract.ts
