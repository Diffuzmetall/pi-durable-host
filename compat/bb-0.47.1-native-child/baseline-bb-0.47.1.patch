index 0000000..9d789dc
--- /dev/null
+++ b/apps/host-daemon/src/native-root-command.ts
@@ -0,0 +1,33 @@
+import { handleRootAttachmentChallenge } from "@bb/agent-runtime";
+import { stableRootProviderId, type RootAttachmentContext } from "@bb/host-daemon-contract";
+import type { AgentRuntimeBridgeLaunch, ResumeThreadArgs, ResumeThreadResult } from "@bb/agent-runtime";
+import type { HostDaemonBridgeLaunch } from "@bb/host-daemon-contract";
+import type { CommandDispatchOptions } from "./command-dispatch-support.js";
+
+type Target = Pick<ResumeThreadArgs, 'environmentId' | 'threadId' | 'projectId' | 'providerId'> & {
+  bridgeLaunch: HostDaemonBridgeLaunch;
+  workspaceContext: { workspacePath: string };
+};
+export async function dispatchRootAttachmentCommand(
+  command: { pluginId: string; attachment: unknown; target?: Target },
+  options: CommandDispatchOptions,
+  resolveBridge: (launch: HostDaemonBridgeLaunch, options: CommandDispatchOptions) => Promise<AgentRuntimeBridgeLaunch>,
+  resolveWorkspace: (args: Record<string, unknown>) => Promise<{ runtime: { resumeThread(args: ResumeThreadArgs): Promise<ResumeThreadResult> }; skillRoots: ResumeThreadArgs['skillRoots'] }>,
+) {
+  return handleRootAttachmentChallenge({
+    challenge: command.attachment, pluginId: command.pluginId, applicationDataDir: options.dataDir,
+    start: async (context: RootAttachmentContext, attempt) => {
+      const target = command.target;
+      if (!target || target.threadId !== context.threadId || target.environmentId !== context.environmentId ||
+          target.projectId !== context.projectId || target.providerId !== context.providerId ||
+          target.bridgeLaunch.pluginId !== command.pluginId) throw Error('ROOT_RUNTIME_TARGET_MISMATCH');
+      const bridgeLaunch = await resolveBridge(target.bridgeLaunch, options);
+      const entry = await resolveWorkspace({ environmentId: target.environmentId,
+        runtimeManager: options.runtimeManager, targetThreadId: target.threadId, workspaceContext: target.workspaceContext });
+      const result = await entry.runtime.resumeThread({ ...target, bridgeLaunch, skillRoots: entry.skillRoots,
+        providerThreadId: stableRootProviderId(context.threadId), rootAttachment: context, rootConfirmation: attempt });
+      if (!result.processGeneration) throw Error('ROOT_RUNTIME_CONFIRMATION_MISSING');
+      return { processGeneration: result.processGeneration };
+    },
+  });
+}
diff --git a/apps/host-daemon/src/native-thread-registration.ts b/apps/host-daemon/src/native-thread-registration.ts
new file mode 100644
index 0000000..f2d2055
--- /dev/null
+++ b/apps/host-daemon/src/native-thread-registration.ts
@@ -0,0 +1,26 @@
+import type { AgentRuntimeOptions } from "@bb/agent-runtime";
+
+type Registrar = NonNullable<AgentRuntimeOptions["onNativeThreadRegistration"]>;
+
+export function createNativeThreadRegistrar(options: {
+  serverUrl: string;
+  hostKey: string;
+  serverHeaders?: Record<string, string>;
+  fetchFn?: typeof fetch;
+}): Registrar {
+  return async request => {
+    const response = await (options.fetchFn ?? fetch)(new URL("/internal/hosts/threads/register-existing", options.serverUrl), {
+      method: "POST",
+      headers: { ...options.serverHeaders, authorization: `Bearer ${options.hostKey}`, "content-type": "application/json" },
+      body: JSON.stringify(request),
+    });
+    if (response.status !== 200 && response.status !== 201) {
+      throw new Error(`Native thread registration refused (${response.status})`);
+    }
+    const body: unknown = await response.json();
+    if (typeof body !== "object" || body === null || !("threadId" in body) || typeof body.threadId !== "string" || !body.threadId) {
+      throw new Error("Invalid native registration response");
+    }
+    return { threadId: body.threadId };
+  };
+}
