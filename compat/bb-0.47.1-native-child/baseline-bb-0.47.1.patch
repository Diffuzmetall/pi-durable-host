@@ -0,0 +1,86 @@
+import { z } from "zod";
+import type { Hono, Context } from "hono";
+import type { AppDeps } from "../types.js";
+import { ROOT_ATTACHMENT_PLUGIN, parseRootAttachmentReceipt } from "./native-root-attachment.js";
+
+interface OwnerScopeCore {
+  getThread: typeof import("@bb/db").getThread;
+  getEnvironment: typeof import("@bb/db").getEnvironment;
+  getStoredProviderSession: typeof import("@bb/db").getStoredProviderSession;
+  getThreadPluginMetadata: typeof import("@bb/db").getThreadPluginMetadata;
+  threadPluginMetadata: typeof import("@bb/db").threadPluginMetadata;
+  eq: typeof import("drizzle-orm").eq;
+  and: typeof import("drizzle-orm").and;
+  desc: typeof import("drizzle-orm").desc;
+  events: typeof import("@bb/db").events;
+}
+const NATIVE = "bb.core.native-registration";
+const querySchema = z.object({ providerId: z.string().min(1).max(200), threadId: z.string().min(1).max(200), providerThreadId: z.string().min(1).max(1025), processGeneration: z.string().uuid().optional() }).strict();
+const nonempty = (value: unknown): value is string => typeof value === "string" && !!value.trim();
+class ScopeDenied extends Error {}
+
+export function registerOwnerScopeRoutes(app: Hono, deps: Pick<AppDeps, "db"> & Partial<Pick<AppDeps, "hub">>, core: OwnerScopeCore,
+  authenticatedDaemon: (context: Context) => { hostId: string }): void {
+  app.post("/hosts/threads/owner-scope", async context => {
+    const daemon = authenticatedDaemon(context);
+    let body: unknown;
+    try { body = await context.req.json(); } catch { return context.json({ error: "Owner scope unavailable" }, 400); }
+    const parsed = querySchema.safeParse(body);
+    if (!parsed.success) return context.json({ error: "Owner scope unavailable" }, 400);
+    const query = parsed.data;
+    try {
+      const result = deps.db.transaction(tx => {
+        const thread = core.getThread(tx, query.threadId);
+        if (!thread || thread.providerId !== query.providerId) throw new ScopeDenied();
+        const identity = core.getStoredProviderSession(tx, thread.id);
+        const latest = tx.select({ providerThreadId: core.events.providerThreadId }).from(core.events)
+          .where(core.and(core.eq(core.events.threadId, thread.id), core.eq(core.events.type, "thread/identity")))
+          .orderBy(core.desc(core.events.sequence)).get();
+        if (identity.kind !== "owned" || identity.providerThreadId !== query.providerThreadId || latest?.providerThreadId !== query.providerThreadId) throw new ScopeDenied();
+        const seen = new Set<string>();
+        let current: typeof thread | null = thread;
+        while (current) {
+          if (seen.has(current.id) || seen.size >= 64 || current.archivedAt !== null || current.deletedAt !== null ||
+            current.providerId !== thread.providerId || current.projectId !== thread.projectId || current.environmentId !== thread.environmentId) throw new ScopeDenied();
+          seen.add(current.id);
+          const environment = current.environmentId ? core.getEnvironment(tx, current.environmentId) : null;
+          if (!environment || environment.hostId !== daemon.hostId || environment.status === "destroyed" || environment.teardownStatus === "removed") throw new ScopeDenied();
+          const metadata = core.getThreadPluginMetadata(tx, current.id, NATIVE);
+          const present = tx.select({ pluginId: core.threadPluginMetadata.pluginId }).from(core.threadPluginMetadata)
+            .where(core.and(core.eq(core.threadPluginMetadata.threadId, current.id), core.eq(core.threadPluginMetadata.pluginId, NATIVE))).get();
+          const marked = current.originPluginId === NATIVE;
+          if (metadata.corrupt || marked && !present) throw new ScopeDenied();
+          if (present) {
+            const binding = metadata.metadata;
+            if (binding.kind !== "native-existing" || binding.hostId !== daemon.hostId || binding.providerId !== current.providerId ||
+              !nonempty(binding.requestId) || !nonempty(binding.sessionId) || !nonempty(binding.conversationId) ||
+              !nonempty(binding.parentThreadId) || binding.parentThreadId !== current.parentThreadId ||
+              current.originKind !== null || (current.originPluginId !== null && !marked)) throw new ScopeDenied();
+          }
+          if (current.parentThreadId === null) {
+            if (marked || present || current.sourceThreadId !== null || current.lifecycleOwnerThreadId !== null ||
+              current.originKind !== null) throw new ScopeDenied();
+            if (current.originPluginId === ROOT_ATTACHMENT_PLUGIN) {
+              const saved = core.getThreadPluginMetadata(tx, current.id, ROOT_ATTACHMENT_PLUGIN);
+              if (saved.corrupt) throw new ScopeDenied();
+              const receipt = parseRootAttachmentReceipt(saved.metadata);
+              if (receipt.threadId !== current.id || receipt.hostId !== daemon.hostId || receipt.providerId !== current.providerId ||
+                receipt.projectId !== current.projectId || receipt.environmentId !== current.environmentId || receipt.phase === 'reserved' || !receipt.rootProfileFingerprint ||
+                !receipt.confirmationAttemptId || !query.processGeneration || receipt.confirmedProcessGeneration !== query.processGeneration ||
+                receipt.daemonSessionId !== deps.hub?.getDaemonSessionIdForHost(daemon.hostId)) throw new ScopeDenied();
+            } else if (current.originPluginId !== null) throw new ScopeDenied();
+            break;
+          }
+          current = core.getThread(tx, current.parentThreadId) ?? null;
+          if (!current) throw new ScopeDenied();
+        }
+        return { providerId: query.providerId, threadId: thread.id, providerThreadId: query.providerThreadId, parentThreadId: thread.parentThreadId };
+      }, { behavior: "deferred" });
+      return context.json(result);
+    } catch (error) {
+      if (error instanceof ScopeDenied) return context.json({ error: "Owner scope unavailable" }, 404);
+      // Read/identity failures cannot become a null/root fallback.
+      return context.json({ error: "Owner scope unavailable" }, 503);
+    }
+  });
+}
diff --git a/apps/server/src/internal/native-root-attachment.ts b/apps/server/src/internal/native-root-attachment.ts
new file mode 100644
index 0000000..88e5713
--- /dev/null
+++ b/apps/server/src/internal/native-root-attachment.ts
@@ -0,0 +1,198 @@
+import { randomUUID } from "node:crypto";
+import { isDeepStrictEqual } from "node:util";
+import { z } from "zod";
+import type { Hono, Context } from "hono";
+import type { AppDeps } from "../types.js";
+import { stableRootProviderId, rootRequestSchema, rootChallengeReplySchema, fingerprintSchema, attachmentPayloadFingerprint,
+  nativeContextFingerprint, rootProfileFingerprint, type RootRequest } from "@bb/host-daemon-contract";
+
+export const ROOT_ATTACHMENT_PLUGIN="bb.core.native-root-attachment";
+const receiptSchema=rootRequestSchema.extend({protocol:z.literal("bb-native-root-admission/v1"),hostId:z.string().min(1),
+  threadId:z.string().min(1),pluginId:z.string().min(1),enrollmentFingerprint:fingerprintSchema,nativeContextFingerprint:fingerprintSchema,
+  phase:z.enum(["reserved","starting","started"]),rootProfileFingerprint:fingerprintSchema.optional(),
+  daemonSessionId:z.string().min(1),confirmationAttemptId:z.string().uuid().optional(),confirmedProcessGeneration:z.string().min(1).optional()}).strict();
+export type RootAttachmentReceipt=z.infer<typeof receiptSchema>;
+const confirmationSchema=z.object({threadId:z.string().min(1),providerId:z.literal("pi-durable"),providerThreadId:z.string().min(1),
+  enrollmentFingerprint:fingerprintSchema,rootProfileFingerprint:fingerprintSchema,processGeneration:z.string().uuid(),
+  attemptId:z.string().uuid(),daemonSessionId:z.string().min(1)}).strict();
+const rpcResponseBase=z.object({type:z.literal('host-rpc.response'),requestId:z.string(),commandType:z.literal('native-root.attachment')});
+const rpcResponseSchema=z.discriminatedUnion('ok',[
+  rpcResponseBase.extend({ok:z.literal(true),result:rootChallengeReplySchema}).strict(),
+  rpcResponseBase.extend({ok:z.literal(false),errorCode:z.string(),errorMessage:z.string()}).strict(),
+]);
+interface RootCore {
+  getProject:typeof import("@bb/db").getProject;
+  getEnvironment:typeof import("@bb/db").getEnvironment;
+  getHost:typeof import("@bb/db").getHost;
+  getThread:typeof import("@bb/db").getThread;
+  getThreadPluginMetadata:typeof import("@bb/db").getThreadPluginMetadata;
+  getStoredProviderSession:typeof import("@bb/db").getStoredProviderSession;
+  createThread:typeof import("@bb/db").createThread;
+  patchThreadPluginMetadata:typeof import("@bb/db").patchThreadPluginMetadata;
+  threadPluginMetadata:typeof import("@bb/db").threadPluginMetadata;
+  threads:typeof import("@bb/db").threads;
+  events:typeof import("@bb/db").events;
+  eq:typeof import("drizzle-orm").eq;
+  and:typeof import("drizzle-orm").and;
+  desc:typeof import("drizzle-orm").desc;
+  requireBridgeLaunch:(deps:AppDeps,providerId:string)=>{pluginId:string;[key:string]:unknown};
+  buildRootTarget:(deps:AppDeps,receipt:RootAttachmentReceipt)=>Promise<Record<string,unknown>>;
+}
+class RootDenied extends Error { constructor(readonly status:400|404|409|503,message="Root attachment unavailable"){super(message);} }
+export function parseRootAttachmentReceipt(value:unknown):RootAttachmentReceipt { return receiptSchema.parse(value); }
+
+export function registerNativeRootAttachmentRoutes(app:Hono,deps:AppDeps,core:RootCore,
+  authenticatedDaemon:(context:Context)=>{hostId:string}):void {
+  const db=deps.db,hub=deps.hub;
+  const current=(hostId:string)=>{
+    const sessionId=hub.getDaemonSessionIdForHost(hostId);
+    if(!sessionId)throw new RootDenied(503);
+    return sessionId;
+  };
+  const scope=(hostId:string,request:RootRequest)=>{
+    const project=core.getProject(db,request.projectId),environment=core.getEnvironment(db,request.environmentId),host=core.getHost(db,hostId);
+    if(!project || !environment || !host || host.phase!=="active" || environment.hostId!==hostId || environment.projectId!==project.id ||
+      environment.status==="destroyed" || environment.teardownStatus==="removed")throw new RootDenied(404);
+    const bridge=core.requireBridgeLaunch(deps,request.providerId);
+    if(!bridge.pluginId)throw new RootDenied(409);
+    return {project,environment,bridge,sessionId:current(hostId)};
+  };
+  const receipts=():RootAttachmentReceipt[]=>{
+    const rows=db.select().from(core.threadPluginMetadata).where(core.eq(core.threadPluginMetadata.pluginId,ROOT_ATTACHMENT_PLUGIN)).all();
+    return rows.map(row=>{try {const r=receiptSchema.parse(JSON.parse(row.metadataJson));if(r.threadId!==row.threadId)throw Error();return r;}
+      catch {throw new RootDenied(409,"Corrupt root admission");}});
+  };
+  const root=(r:RootAttachmentReceipt)=>{
+    const t=core.getThread(db,r.threadId);
+    if(!t || t.deletedAt!==null || t.archivedAt!==null || t.parentThreadId!==null || t.sourceThreadId!==null || t.lifecycleOwnerThreadId!==null ||
+      t.originKind!==null || t.originPluginId!==ROOT_ATTACHMENT_PLUGIN || t.projectId!==r.projectId || t.environmentId!==r.environmentId || t.providerId!==r.providerId)
+      throw new RootDenied(409);
+    return t;
+  };
+  const save=(r:RootAttachmentReceipt)=>core.patchThreadPluginMetadata(db,{threadId:r.threadId,pluginId:ROOT_ATTACHMENT_PLUGIN,set:r,remove:[]});
+  const find=(hostId:string,request:RootRequest)=>{
+    const matches=receipts().filter(r=>r.hostId===hostId && r.requestId===request.requestId);
+    if(matches.length>1)throw new RootDenied(409);
+    const r=matches[0];
+    if(r){root(r);if(!isDeepStrictEqual({requestId:r.requestId,projectId:r.projectId,environmentId:r.environmentId,providerId:r.providerId},request))throw new RootDenied(409);}
+    return r;
+  };
+  async function challenge(hostId:string,request:RootRequest,phase:"enrollment"|"profile"|"start",r?:RootAttachmentReceipt){
+    const s=scope(hostId,request),challengeId=phase==='start'?r?.confirmationAttemptId:randomUUID();
+    if(!challengeId)throw new RootDenied(409);
+    if(phase==="start" && r?.daemonSessionId!==s.sessionId)throw new RootDenied(409);
+    const attachment={type:"native-root.attachment",phase,challengeId,daemonSessionId:s.sessionId,hostId,request,
+      ...(r?{threadId:r.threadId,enrollmentFingerprint:r.enrollmentFingerprint}:{}),
+      ...(phase==="start"?{rootProfileFingerprint:r?.rootProfileFingerprint}:{})};
+    const target=phase==="start" && r ? await core.buildRootTarget(deps,r):undefined;
+    if(current(hostId)!==s.sessionId)throw new RootDenied(409);
+    // Existing actual Hub binds reply to this CURRENT authenticated socket/session; no retry/reconnect helper.
+    const response=rpcResponseSchema.parse(await hub.requestHostOnlineRpc({hostId,timeoutMs:30_000,message:{type:"host-rpc.request",requestId:challengeId,
+      command:{type:"native-root.attachment",pluginId:s.bridge.pluginId,attachment,...(target?{target}:{})} as never}}));
+    if(current(hostId)!==s.sessionId || response.requestId!==challengeId)throw new RootDenied(409);
+    if(!response.ok){
+      if(response.errorMessage.startsWith('BB_OBSERVATION_REOPEN_REQUIRED:'))throw new RootDenied(409,'BB_OBSERVATION_REOPEN_REQUIRED');
+      throw new RootDenied(409);
+    }
+    const reply=rootChallengeReplySchema.parse(response.result);
+    if(reply.challengeId!==challengeId)throw new RootDenied(409);
+    if(reply.status==="enrollment-required"){
+      if(phase!=="enrollment")throw new RootDenied(409);
+      return reply;
+    }
+    if(reply.hostId!==hostId || !isDeepStrictEqual(reply.request,request) || reply.enrollment.hostId!==hostId ||
+      !isDeepStrictEqual({requestId:reply.enrollment.requestId,projectId:reply.enrollment.projectId,environmentId:reply.enrollment.environmentId,providerId:reply.enrollment.providerId},request) ||
+      attachmentPayloadFingerprint(reply.enrollment)!==reply.enrollmentFingerprint || (r && r.enrollmentFingerprint!==reply.enrollmentFingerprint))throw new RootDenied(409);
+    if(phase!=="enrollment" && !reply.profileFile)throw new RootDenied(409);
+    if(reply.profile){
+      if(!r || reply.profile.grantPath!==reply.enrollment.grantPath || reply.profile.descriptorPath!==reply.enrollment.descriptorPath ||
+        rootProfileFingerprint(r.threadId,reply.enrollmentFingerprint,reply.profile)!==reply.rootProfileFingerprint)throw new RootDenied(409);
+    } else if(reply.rootProfileFingerprint!==undefined)throw new RootDenied(409);
+    if(phase==="start" && (!reply.profile || !reply.processGeneration || reply.rootProfileFingerprint!==r?.rootProfileFingerprint))throw new RootDenied(409);
+    return reply;
+  }
+  async function body(context:Context){
+    const raw=await context.req.text();if(Buffer.byteLength(raw)>8192)throw new RootDenied(400);
+    try {return rootRequestSchema.parse(JSON.parse(raw));} catch {throw new RootDenied(400,"Invalid root attachment request");}
+  }
+  const failure=(context:Context,error:unknown)=>context.json({error:error instanceof RootDenied?error.message:"Root attachment refused"},
+    error instanceof RootDenied?error.status:409);
+
+  app.post("/hosts/threads/attach-existing-root",async context=>{
+    try {
+      const {hostId}=authenticatedDaemon(context),request=await body(context),admissionSession=scope(hostId,request).sessionId;
+      // Even an idempotent return requires current private intent proof, never just a daemon key.
+      const proof=await challenge(hostId,request,"enrollment");
+      if(proof.status==="enrollment-required")return context.json({status:proof.status,enrollmentFile:proof.enrollmentFile});
+      if(current(hostId)!==admissionSession)throw new RootDenied(409);
+      let created=false;
+      const r=db.transaction(()=>{
+        const s=scope(hostId,request),existing=find(hostId,request);
+        if(s.sessionId!==admissionSession)throw new RootDenied(409);
+        if(existing){if(existing.enrollmentFingerprint!==proof.enrollmentFingerprint || existing.pluginId!==s.bridge.pluginId)throw new RootDenied(409);return existing;}
+        const nativeFP=nativeContextFingerprint(proof.enrollment);
+        if(receipts().some(other=>other.nativeContextFingerprint===nativeFP))throw new RootDenied(409,"Native context already admitted");
+        const t=core.createThread(db,hub,{projectId:request.projectId,environmentId:request.environmentId,providerId:request.providerId,
+          parentThreadId:null,status:"pending",originPluginId:ROOT_ATTACHMENT_PLUGIN,pluginMetadata:{pluginId:ROOT_ATTACHMENT_PLUGIN,
+            metadata:{}}});
+        const receipt=receiptSchema.parse({protocol:"bb-native-root-admission/v1",...request,hostId,threadId:t.id,pluginId:s.bridge.pluginId,
+          enrollmentFingerprint:proof.enrollmentFingerprint,nativeContextFingerprint:nativeFP,phase:"reserved",daemonSessionId:s.sessionId});
+        save(receipt);created=true;return receipt;
+      },{behavior:"immediate"});
+      const profile=await challenge(hostId,request,"profile",r);
+      if(profile.status!=="validated" || !profile.profileFile || (r.rootProfileFingerprint && profile.rootProfileFingerprint!==r.rootProfileFingerprint))throw new RootDenied(409);
+      return context.json({status:"reserved",threadId:r.threadId,enrollmentFingerprint:r.enrollmentFingerprint,profileFile:profile.profileFile},created?201:200);
+    } catch(error){return failure(context,error);}
+  });
+  app.post("/hosts/threads/:threadId/start-existing-root",async context=>{
+    try {
+      const {hostId}=authenticatedDaemon(context),request=await body(context),s=scope(hostId,request);
+      let r=find(hostId,request);if(!r || r.threadId!==context.req.param("threadId") || r.pluginId!==s.bridge.pluginId)throw new RootDenied(404);
+      const proof=await challenge(hostId,request,"profile",r);
+      if(current(hostId)!==s.sessionId || proof.status!=="validated" || !proof.profile || !proof.rootProfileFingerprint)throw new RootDenied(409);
+      const profileFingerprint=proof.rootProfileFingerprint;
+      r=db.transaction(()=>{
+        const latest=find(hostId,request);if(!latest || latest.threadId!==r!.threadId || latest.enrollmentFingerprint!==r!.enrollmentFingerprint ||
+          (latest.rootProfileFingerprint && latest.rootProfileFingerprint!==proof.rootProfileFingerprint))throw new RootDenied(409);
+        const next={...latest,phase:"starting" as const,daemonSessionId:current(hostId),rootProfileFingerprint:profileFingerprint,
+          confirmationAttemptId:randomUUID()};
+        // A retired generation must not remain positive during a new bootstrap.
+        const {confirmedProcessGeneration:_,...pending}=next;
+        core.patchThreadPluginMetadata(db,{threadId:pending.threadId,pluginId:ROOT_ATTACHMENT_PLUGIN,set:pending,remove:["confirmedProcessGeneration"]});
+        return pending;
+      },{behavior:"immediate"});
+      const started=await challenge(hostId,request,"start",r);
+      const confirmed=find(hostId,request);
+      if(started.status!=="validated" || !confirmed?.confirmedProcessGeneration || confirmed.confirmedProcessGeneration!==started.processGeneration ||
+        confirmed.daemonSessionId!==current(hostId) || confirmed.confirmationAttemptId!==r.confirmationAttemptId)throw new RootDenied(409);
+      save({...confirmed,phase:"started"});
+      return context.json({status:"started",threadId:confirmed.threadId});
+    } catch(error){return failure(context,error);}
+  });
+  app.post("/hosts/threads/confirm-root-attachment",async context=>{
+    try {
+      const {hostId}=authenticatedDaemon(context);
+      const raw=await context.req.text();if(Buffer.byteLength(raw)>8192)throw new RootDenied(400);
+      const q=confirmationSchema.parse(JSON.parse(raw));
+      const r=receipts().find(item=>item.threadId===q.threadId);
+      if(!r || r.hostId!==hostId || r.providerId!==q.providerId || r.phase==="reserved" || r.enrollmentFingerprint!==q.enrollmentFingerprint ||
+        r.rootProfileFingerprint!==q.rootProfileFingerprint || r.daemonSessionId!==current(hostId) ||
+        r.daemonSessionId!==q.daemonSessionId || r.confirmationAttemptId!==q.attemptId ||
+        (r.confirmedProcessGeneration!==undefined && r.confirmedProcessGeneration!==q.processGeneration))throw new RootDenied(404);
+      scope(hostId,r);root(r);
+      if(q.providerThreadId!==stableRootProviderId(q.threadId))throw new RootDenied(404);
+      const settled=db.transaction(()=>{
+        const identity=core.getStoredProviderSession(db,q.threadId);
+        const latest=db.select({providerThreadId:core.events.providerThreadId}).from(core.events)
+          .where(core.and(core.eq(core.events.threadId,q.threadId),core.eq(core.events.type,"thread/identity"))).orderBy(core.desc(core.events.sequence)).get();
+        if(identity.kind!=="owned" || identity.providerThreadId!==q.providerThreadId || latest?.providerThreadId!==q.providerThreadId)throw new RootDenied(404);
+        save({...r,confirmedProcessGeneration:q.processGeneration});
+        // Observation readiness is not a run; never synthesize turn lifecycle events.
+        return db.update(core.threads).set({status:"idle",updatedAt:Date.now()})
+          .where(core.and(core.eq(core.threads.id,q.threadId),core.eq(core.threads.status,"pending"))).returning().get();
+      },{behavior:"immediate"});
+      if(settled)hub.notifyThread(q.threadId,["status-changed"],{projectId:settled.projectId});
+      return context.json({threadId:q.threadId});
+    } catch(error){return failure(context,error);}
+  });
+}
diff --git a/apps/server/src/internal/native-root-recovery.ts b/apps/server/src/internal/native-root-recovery.ts
new file mode 100644
index 0000000..11982bd
--- /dev/null
+++ b/apps/server/src/internal/native-root-recovery.ts
@@ -0,0 +1,113 @@
+import { createHash } from 'node:crypto';
+import { rootRecoveryDigest, rootRecoveryRequestSchema, rootRecoveryReceiptSchema, type RootRecoveryBackup, type RootRecoveryRequest } from "@bb/host-daemon-contract";
+import { NativeHistoryError, type NativeHistoryCore } from "@bb/db";
+
+export const ROOT_RECOVERY_PLUGIN = 'bb.core.native-root-recovery';
+
+/** Explicit operator repair, not normal attach. The existing Core remains the only writer. */
+export function recoverNativeRoot(db: import('@bb/db').DbConnection, hostId: string,
+  raw: RootRecoveryRequest, core: NativeHistoryCore) {
+  const input = rootRecoveryRequestSchema.parse(raw);
+  const result = db.transaction(tx => {
+    const thread = core.getThread(tx, input.threadId);
+    const environment = thread?.environmentId ? core.getEnvironment(tx, thread.environmentId) : undefined;
+    const canonical = `pi_durable_bb_${createHash('sha256').update(input.threadId).digest('hex')}`;
+    if (!thread || thread.deletedAt !== null || thread.archivedAt !== null || thread.parentThreadId !== null ||
+      thread.providerId !== 'pi-durable' || input.providerThreadId !== canonical || !environment || environment.hostId !== hostId)
+      throw new NativeHistoryError(404, 'Native root not found in requester scope');
+    if (!['idle', 'error'].includes(thread.status)) throw new NativeHistoryError(409, 'Root recovery requires a non-executing BB thread');
+    const rows = tx.select().from(core.events).where(core.eq(core.events.threadId, input.threadId)).orderBy(core.events.sequence).all();
+    const data = (row: typeof rows[number]): Record<string, any> => {
+      if (row.threadId !== thread.id || (row.environmentId !== null && row.environmentId !== thread.environmentId) ||
+        (row.providerThreadId !== null && row.providerThreadId !== input.providerThreadId))
+        throw new NativeHistoryError(409, 'Foreign root history cannot be repaired');
+      try {
+        const value = JSON.parse(row.data);
+        if (!value || typeof value !== 'object' || Array.isArray(value)) throw Error();
+        if (value.providerThreadId !== undefined && value.providerThreadId !== input.providerThreadId) throw Error();
+        return value;
+      } catch { throw new NativeHistoryError(409, 'Invalid root history'); }
+    };
+    const decoded = rows.map(row => ({ row, data: data(row) }));
+    if (!decoded.some(entry => entry.row.type === 'thread/identity' && entry.data.providerThreadId === input.providerThreadId))
+      throw new NativeHistoryError(409, 'Persisted native root identity required');
+    const receipt = core.getThreadPluginMetadata(tx, input.threadId, ROOT_RECOVERY_PLUGIN);
+    if (receipt.corrupt || (Object.keys(receipt.metadata).length && !rootRecoveryReceiptSchema.safeParse(receipt.metadata).success))
+      throw new NativeHistoryError(409, 'Corrupt root recovery receipt');
+    const backup: RootRecoveryBackup = { protocol: 'bb-native-root-recovery-backup/v1', hostId,
+      threadId: input.threadId, providerThreadId: input.providerThreadId, thread, events: rows, metadata: receipt.metadata };
+    const backupDigest = rootRecoveryDigest(backup);
+    if (input.operation === 'prepare') return { status: 'prepared' as const, threadId: input.threadId, backupDigest, backup };
+
+    const snapshotDigest = rootRecoveryDigest(input.snapshot);
+    const stateDigest = () => rootRecoveryDigest([core.getThread(tx, input.threadId),
+      tx.select().from(core.events).where(core.eq(core.events.threadId, input.threadId)).orderBy(core.events.sequence).all()]);
+    const old = receipt.metadata;
+    if (old.backupDigest === input.backupDigest && old.snapshotDigest === snapshotDigest && old.afterStateDigest === stateDigest())
+      return { status: 'recovered' as const, threadId: input.threadId, changed: false, turnId: String(old.turnId), itemId: String(old.itemId) };
+    if (input.backupDigest !== backupDigest) throw new NativeHistoryError(409, 'Root changed after backup; no automatic rebase');
+
+    const turn = [...decoded].reverse().find(entry => entry.row.type === 'turn/started' && entry.row.scopeKind === 'turn' && entry.row.turnId);
+    if (!turn) throw new NativeHistoryError(409, 'Existing BB turn required; recovery never creates a new turn');
+    const turnId = turn.row.turnId!;
+    const accepted = new Map<string, { turnId: string; text: string }>();
+    for (const entry of decoded.filter(entry => entry.row.type === 'turn/input/accepted')) {
+      const requestId = entry.data.clientRequestId;
+      const requests = decoded.filter(candidate => candidate.row.type === 'client/turn/requested' && candidate.data.requestId === requestId);
+      const chunks = requests[0]?.data.input;
+      if (typeof requestId !== 'string' || requests.length !== 1 || entry.row.scopeKind !== 'turn' || !entry.row.turnId ||
+        !Array.isArray(chunks) || !chunks.length || chunks.some(chunk => chunk?.type !== 'text' || typeof chunk.text !== 'string'))
+        throw new NativeHistoryError(409, 'Unprovable accepted root input lineage');
+      const value = { turnId: entry.row.turnId, text: chunks.map(chunk => chunk.text).join('\n').trim() };
+      const previous = accepted.get(requestId);
+      if (previous && (previous.turnId !== value.turnId || previous.text !== value.text))
+        throw new NativeHistoryError(409, 'Conflicting accepted root input');
+      accepted.set(requestId, value);
+    }
+    const lineage = [...accepted.values()];
+    // Root input RPC has no native admission receipt. Refuse repeated text rather than guessing
+    // which identical request ran; compacted/external/missing native inputs also refuse recovery.
+    if (!lineage.length || lineage.at(-1)!.turnId !== turnId || lineage.length !== input.snapshot.inputs.length ||
+      new Set(lineage.map(value => value.text)).size !== lineage.length ||
+      lineage.some((value, index) => value.text !== input.snapshot.inputs[index].text))
+      throw new NativeHistoryError(409, 'Native input lineage does not uniquely match accepted BB requests');
+
+    // Repair an unfinished matching text item in place; never erase an earlier completed answer or tool history.
+    const messages = new Map<string, { text: string; complete: boolean }>();
+    for (const entry of decoded.filter(entry => entry.row.turnId === turnId && entry.row.parentToolCallId === null)) {
+      const { type } = entry.row, item = entry.data.item;
+      if (['item/started', 'item/completed'].includes(type) && item?.type === 'agentMessage' && typeof item.id === 'string' && typeof item.text === 'string')
+        messages.set(item.id, { text: item.text, complete: type === 'item/completed' });
+      if (type === 'item/agentMessage/delta' && typeof entry.data.itemId === 'string' && typeof entry.data.delta === 'string') {
+        const previous = messages.get(entry.data.itemId);
+        if (!previous || previous.complete) throw new NativeHistoryError(409, 'Ambiguous streamed root message');
+        previous.text += entry.data.delta;
+      }
+    }
+    const candidates = [...messages.entries()].filter(([, value]) => value.text === input.snapshot.answerText ||
+      (!value.complete && value.text.length > 0 && input.snapshot.answerText.startsWith(value.text)));
+    const last = [...messages.entries()].at(-1);
+    if (candidates.length > 1 || (candidates.length === 1 && candidates[0][0] !== last?.[0]))
+      throw new NativeHistoryError(409, 'Ambiguous root answer item; no automatic replacement');
+    const matching = candidates.length === 1;
+    const itemId = matching ? last![0] : `nr-i-${rootRecoveryDigest([hostId, input.providerThreadId, turnId, input.snapshot.sessionId, input.snapshot.answerEntryId])}`;
+    const base = { threadId: input.threadId, environmentId: thread.environmentId, providerThreadId: input.providerThreadId,
+      scope: { kind: 'turn' as const, turnId } };
+    const appended: Parameters<NativeHistoryCore['appendStoredThreadEventsInTransaction']>[1][number][] = [];
+    if (!matching || !last![1].complete) appended.push({ ...base, type: 'item/completed',
+      data: { providerThreadId: input.providerThreadId, item: { type: 'agentMessage', id: itemId, text: input.snapshot.answerText } } });
+    const completed = [...decoded].reverse().find(entry => entry.row.turnId === turnId && entry.row.type === 'turn/completed');
+    if (!completed || completed.data.status !== input.snapshot.status) appended.push({ ...base, type: 'turn/completed',
+      data: { providerThreadId: input.providerThreadId, status: input.snapshot.status } });
+    // No removal, input acceptance, dispatch, queue drain or model callback. Backup protects the original status too.
+    core.appendStoredThreadEventsInTransaction(tx, appended);
+    tx.update(core.threads).set({ status: input.snapshot.status === 'failed' ? 'error' : 'idle' }).where(core.eq(core.threads.id, input.threadId)).run();
+    const metadataJson = JSON.stringify({ version: 1, backupDigest: input.backupDigest, snapshotDigest,
+      afterStateDigest: stateDigest(), turnId, itemId });
+    tx.insert(core.threadPluginMetadata).values({ threadId: input.threadId, pluginId: ROOT_RECOVERY_PLUGIN, metadataJson })
+      .onConflictDoUpdate({ target: [core.threadPluginMetadata.threadId, core.threadPluginMetadata.pluginId], set: { metadataJson } }).run();
+    return { status: 'recovered' as const, threadId: input.threadId, changed: true, turnId, itemId };
+  }, { behavior: 'immediate' });
+  if (result.status === 'recovered' && result.changed) core.bumpThreadEventRewriteGeneration(input.threadId);
+  return result;
+}
