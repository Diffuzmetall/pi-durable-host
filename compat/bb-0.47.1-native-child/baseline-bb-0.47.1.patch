@@ -0,0 +1,27 @@
+import { z } from 'zod';
+import { rootChallengeSchema, rootChallengeReplySchema } from './native-root-attachment.js';
+
+export function rootAttachmentCommandDescriptor<T extends z.ZodObject<any>>(targetSchema: T) {
+  const observationTarget = z.object({
+    environmentId: targetSchema.shape.environmentId,
+    threadId: targetSchema.shape.threadId,
+    workspaceContext: targetSchema.shape.workspaceContext,
+    projectId: targetSchema.shape.projectId,
+    providerId: targetSchema.shape.providerId,
+    bridgeLaunch: targetSchema.shape.bridgeLaunch,
+  }).strict();
+  return {
+    type: 'native-root.attachment',
+    schema: z.object({
+      type: z.literal('native-root.attachment'),
+      pluginId: z.string().min(1),
+      attachment: rootChallengeSchema,
+      target: observationTarget.optional(),
+    }).strict().superRefine((command, ctx) => {
+      if ((command.attachment.phase === 'start') !== (command.target !== undefined))
+        ctx.addIssue({ code: 'custom', message: 'Only start requires a runtime target' });
+    }),
+    resultSchema: rootChallengeReplySchema,
+    transport: 'onlineRpc', retryable: false, flushEventsBeforeResult: true, envLane: null,
+  } as const;
+}
