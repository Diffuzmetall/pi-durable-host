{
  "name": "dpi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Durable Pi device server: hosts durable sessions and exposes them over an authenticated HTTP + SSE API (v1).",
  "bin": { "dpi-backend": "dist/dpi-backend/src/main.js" },
  "exports": {
    "./store": "./dist/dpi-backend/src/store.js",
    "./profiles": "./dist/dpi-backend/src/runtime-profile.js",
    "./server": "./dist/dpi-backend/src/http-server.js",
    "./native-profile": "./dist/dpi-backend/src/native-profile/profile.js"
  },
  "files": ["dist/dpi-backend/src/*.js", "dist/dpi-backend/src/*.d.ts", "dist/dpi-backend/src/native-profile", "dist/dpi-backend/prompts", "dist/dpi-sdk/src/*.js", "dist/dpi-sdk/src/*.d.ts", "LICENSE", "README.md", "INSTALL.md", "NATIVE.md"],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "prepack": "npm run build",
    "package-smoke": "node scripts/package-smoke.mjs",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "check": "tsc --noEmit -p .",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "token": "tsx scripts/token.ts",
    "migrate-playground": "tsx scripts/migrate-playground.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-mcp": "1.0.2",
    "cross-spawn": "7.0.6",
    "hosted-git-info": "9.0.3",
    "ignore": "7.0.8",
    "minimatch": "10.2.6",
    "semver": "7.8.5",
    "yaml": "2.9.0",
    "express": "^5.1.0",
    "typebox": "1.3.27",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/hosted-git-info": "3.0.5",
    "@types/semver": "7.7.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
